# Windows batch files want to use CRLF by default.
*.bat text eol=crlf

# sh で動くフックは LF（#315）
.githooks/* text eol=lf

# コンテナの中の sh で動く。CRLF だと「not found」で動かず、DDL が流れない（#324）
*.sh text eol=lf

# Visual Studio files want to use CRLF by default.

# env_file は LF でなければならない（#281）。
#   core.autocrlf が true の Windows で CRLF になると、
#   docker compose が読んだ値の末尾に CR が残る。
#   パスの末尾に CR が付くと、**そのファイルを使った瞬間に落ちる。**
*.env text eol=lf
