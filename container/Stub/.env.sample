# MPAS スタブの起動パラメタ（docker compose --env-file で渡す）。README.md の 2 節。
#   **写して使う**（例 : my-stub.env。**my- で始めれば .gitignore 済み**）。**書いていないキーは、docker-compose.yml の既定値になる。**
#   **相対パスは、docker-compose.yml の在るディレクトリ（container\Stub\）から見たもの。**

# ---- 待ち受け
# ホストに公開するポート
STUB_PORT=44310
# 公開 URL（RP がブラウザ・サーバから使う URL）。**ポートを変えたら、ここも変える。**
STUB_PUBLIC_URL=https://localhost:44310
# 名乗る iss。**RP の期待する issuer と揃える**（既定は公開 URL と同じ）。
STUB_ISSUER=https://localhost:44310

# ---- アプリの設定の土台（既定は開発者の手元の appsettings.json。管理者・テスト利用者・テスト用の口もここの値）
STUB_APPSETTINGS=../../root/programs/MultiPurposeAuthSiteCore/MultiPurposeAuthSiteCore/appsettings.json

# ---- アプリの追加の設定（クライアントの登録など。appsettings.json と同じ書き方の JSON。土台に重ねて効く）
STUB_SETTINGS=./appsettings.Stub.sample.json

# ---- HTTPS の証明書（既定は 1_PublishStub.ps1 が書き出すホストの開発用証明書）
#   自分の証明書を使うなら : STUB_CERT_DIR に aspnetapp.pfx を置き、
#   STUB_CERT_ENV_FILE に「Kestrel__Certificates__Default__Password=<パスワード>」の 1 行を書く。
STUB_CERT_DIR=./cert
STUB_CERT_ENV_FILE=./cert/cert.env

# ---- 署名鍵などのリソース（root\Readme.ja.md の手順で用意したもの）
STUB_RESOURCE_DIR=C:/root/files/resource
