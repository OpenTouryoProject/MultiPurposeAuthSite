@model ManageSaml2OAuth2DataListViewModel

@{
    ViewBag.Title = ManageViews.Saml2OAuth2DataListTitle;
}

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title</h2>

<p class="text-success">@ViewBag.StatusMessage</p>

@*
    **1 利用者 n クライアント**（#307 の段階 5-a-1）になったので、**並べて選べる画面**である。
    **前例は `ConsentGrants`**（同意の一覧。表 ＋ 行ごとのフォーム）。

    **出るのは自分の登録だけ**（所有者で引いている）。
    **並びは `client_id` の昇順**（`DataProvider.GetByOwner`。方言 3 つと `mem` で同じ）。

    **`client_secret` は出さない** — **編集の画面で見せる**（この画面は選ぶための物である）。
*@
<p>[&nbsp;&nbsp;@Html.ActionLink(ManageViews.Saml2OAuth2DataListAddActionLink, "AddSaml2OAuth2Data")&nbsp;&nbsp;]</p>

@if (Model.Registrations.Count == 0)
{
    <p>@ManageViews.Saml2OAuth2DataListNone</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@ManageViews.Saml2OAuth2DataListClientID</th>
                <th>@ManageViews.Saml2OAuth2DataListClientMode</th>
                <th>@ManageViews.Saml2OAuth2DataListRedirectUriCode</th>
                <th>@ManageViews.Saml2OAuth2DataListSource</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Saml2OAuth2DataRowViewModel registration in Model.Registrations)
            {
                <tr>
                    <td>@registration.ClientID</td>
                    <td>@registration.ClientMode</td>
                    <td>@registration.RedirectUriCode</td>
                    <td>
                        @*  **動的登録で作られた行**は、そう出す（#307 の段階 2 の列の有無で見ている）。
                            **その行は RP が管理 API（RFC 7592）でも直せる** —
                            **画面から `client_id` を作り直すと、その経路が切れる**
                            （だから編集では作り直せないようにしてある）。 *@
                        @if (registration.IsDynamic)
                        {
                            <text>@ManageViews.Saml2OAuth2DataListSourceDynamic</text>
                        }
                        else
                        {
                            <text>@ManageViews.Saml2OAuth2DataListSourceScreen</text>
                        }
                    </td>
                    <td>
                        @*  **編集は GET である**（**どの 1 件かを `clientId` で渡す**）。
                            **所有者はサーバ側で照合する** —
                            **他人の `client_id` を書き換えて開いても、エラー画面になる。** *@
                        [&nbsp;@Html.ActionLink(ManageViews.Saml2OAuth2DataListEditActionLink,
                            "AddSaml2OAuth2Data", new { clientId = registration.ClientID })&nbsp;]
                    </td>
                    <td>
                        @using (Html.BeginForm("RemoveSaml2OAuth2Data", "Manage", FormMethod.Post,
                            new { @class = "form-horizontal", role = "form", onsubmit = "Fx_OnSubmit();" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="clientId" value="@registration.ClientID" />
                            <input type="submit" class="btn btn-default"
                                   value="@ManageViews.Saml2OAuth2DataListRemoveButton" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* スクリプト・セクション（RenderSection("FooterScriptsSection", required: true)に出力されます） *@
@section FooterScriptsSection{
    <!-- Footer 部の section -->
}
