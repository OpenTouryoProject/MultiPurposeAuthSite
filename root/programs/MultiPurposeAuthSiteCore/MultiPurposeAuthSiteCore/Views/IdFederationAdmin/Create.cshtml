@model IdFederationUpstreamViewModel

@{
    ViewBag.Title = "Create ID Federation Upstream";
}

@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("Create", "IdFederationAdmin", FormMethod.Post,
    new { @class = "form-horizontal", role = "form", onsubmit = "Fx_OnSubmit();" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @* **鍵は追加のときだけ入れられる**（PK なので、後から変えない） *@
    <div class="form-group">
        @Html.LabelFor(m => m.UpstreamKey, new { @class = "col-md-3 control-label" })
        <div class="col-md-9">
            @Html.TextBoxFor(m => m.UpstreamKey, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.UpstreamKey, "", new { @class = "text-danger" })
        </div>
    </div>

    @await Html.PartialAsync("_Form", Model)

    <div class="form-group">
        <div class="col-md-offset-3 col-md-9">
            <button type="submit" class="btn btn-primary">Create</button>
            @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-default" })
        </div>
    </div>
}

@section FooterScriptsSection{
    <!-- Footer 部の section -->
}
