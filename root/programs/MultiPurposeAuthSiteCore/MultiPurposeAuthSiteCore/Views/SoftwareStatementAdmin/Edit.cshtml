@model SoftwareStatementIssuerViewModel

@{
    ViewBag.Title = "Edit software_statement Issuer";
}

@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("Edit", "SoftwareStatementAdmin", FormMethod.Post,
    new { @class = "form-horizontal", role = "form", onsubmit = "Fx_OnSubmit();" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @* **鍵は変えられない**（PK）。**hidden で持ち回る。** *@
    @Html.HiddenFor(m => m.IssuerKey)
    <div class="form-group">
        @Html.LabelFor(m => m.IssuerKey, new { @class = "col-md-3 control-label" })
        <div class="col-md-9">
            <p class="form-control-static">@Model.IssuerKey</p>
        </div>
    </div>

    @await Html.PartialAsync("_Form", Model)

    <div class="form-group">
        <div class="col-md-offset-3 col-md-9">
            <button type="submit" class="btn btn-primary">Save</button>
            @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-default" })
        </div>
    </div>
}

@section FooterScriptsSection{
    <!-- Footer 部の section -->
}
