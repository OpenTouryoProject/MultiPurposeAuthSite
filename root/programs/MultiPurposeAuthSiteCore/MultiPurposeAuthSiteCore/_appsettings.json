    "OAuth2AuthorizationCodeGrantClient_Manage": "/Manage/OAuth2AuthorizationCodeGrantClient",

    // Client
    // Clientエンドポイント
    "OAuth2ClientEndpointsRootURI": "https://localhost:44300/MultiPurposeAuthSite",
    // Redirectエンドポイント
    // Redirectエンドポイント（テスト用）のロックダウン
    // **DataProtection の鍵の置き場**（#251。net10.0 版だけで使う）。
    //   **空なら従来どおり**（%LOCALAPPDATA% 配下。**コンテナでは揮発する**）。
    //   指定すると、そこに鍵リングを置くので、**再起動でもサインインが切れない。**
    //   net48 の machineKey と同じ役割だが、**鍵そのものは書かない**（置き場を共有する）。
    //   **鍵リングは平文の XML。** 置き場の保護は運用側の責任。
    //   例 : /keys（コンテナ）
    "DataProtectionKeyPath": "",

    // 配備で切り替えるもの（#279。net10.0 版だけ）。
    //   いずれも、書かなければ従来どおりの動作である。
    //   UseHttpsRedirection          : on で HTTP を HTTPS へリダイレクトする
    //                                  （ポートも決めること。ASPNETCORE_HTTPS_PORT は**単数**）
    //   CookieSecurePolicy           : always で Cookie に Secure 属性を必ず付ける
    //                                  （平文 HTTP の環境で付けるとサインインできなくなる）
    //   UseForwardedHeaders          : on で X-Forwarded-Proto / -For を取り込む
    //                                  （前段で TLS を終端する構成。詐称を許すので、アプリを直に叩ける環境では使わない）
    //   ForwardedHeadersKnownProxies : 信用する前段のアドレス（カンマ区切り。空なら範囲を制限しない）
    "UseHttpsRedirection": "",
    "CookieSecurePolicy": "",
    "UseForwardedHeaders": "",
    "ForwardedHeadersKnownProxies": "",
