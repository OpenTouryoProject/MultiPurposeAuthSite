{
  // connectionStrings section
  "connectionStrings": {
    "ConnectionString_SQL": "Data Source=localhost;Initial Catalog=UserStore;User ID=sa;Password=seigi@123;Encrypt=false;",
    "ConnectionString_ODP": "User Id=SCOTT;Password=tiger;Data Source=localhost/FREEPDB1;",
    "ConnectionString_NPS": "HOST=localhost;DATABASE=UserStore;USER ID=postgres;PASSWORD=seigi@123;"
  },

  // sessionState section
  "sessionState": {
    "SessionCookieName": "MultiPurposeAuthSiteCoreSession"
  },

  // appSettings section
  "appSettings": {
    // Webサービス用
    //"Azure": "MultiPurposeAuthSiteCore",

    // フレームワークの使用するパラメータ - start
    // 基盤画面パス"
    "FxErrorScreenPath": "/Error/Index",
    // 共有情報定義へのパス
    "FxXMLSPDefinition": "C:/root/files/resource/XML/SPDefinition.xml",
    // メッセージ定義へのパス
    "FxXMLMSGDefinition": "C:/root/files/resource/XML/MSGDefinition.xml",
    // Log4Netのコンフィグファイルへのパス
    "FxLog4NetConfFile": "C:/root/files/resource/Log/SampleLogConf.xml",
    // セッションタイムアウト検出機能のon・off
    "FxSessionTimeOutCheck": "off", // 外部ログイン不具合対応
    // ONにするとOpen棟梁 GetConfigParameterで設定ファイルより環境変数を優先。
    "FxContainerization": "on",
    // キャッシュ制御機能のon・off
    "FxCacheControl": "on",
    // フレームワークの使用するパラメータ - end

    // Proxy設定
    // InternetProxy設定 (Internet アクセス用、)
    "UseInternetProxy": "false",
    "InternetProxyURL": "[If necessary, please fill in internal proxy url]",
    "InternetProxyUID": "[If necessary, please fill in user Id for proxy credential]",
    "InternetProxyPWD": "[If necessary, please fill in password for proxy credential]",
    // IntranetProxy設定 (Intranet アクセス用、基本falseを想定)
    "UseIntranetProxy": "false",
    "IntranetProxyURL": "",
    "IntranetProxyUID": "",
    "IntranetProxyPWD": "",
    // DebugProxy設定 (Fiddler)
    "UseDebugProxy": "false",
    "DebugProxyURL": "http://localhost:8888/",
    "DebugProxyUID": "",
    "DebugProxyPWD": "",

    // ASP.NET Identity
    // Debugかどうか
    "IsDebug": "true",
    "EnableDebugTraceLog": "true",

    // User store type (mem, sql, ora, npg)
    "UserStoreType": "mem",
    
    // **net10.0 版だけ**
    // Session store type (mem, sql, redis)
    "SessionStoreType": "mem",
    // Session store connection string **mem なら空のまま。**
    "SessionStoreConnectionString": "",
    // DataProtectionKeyPath 鍵の置き場 
    // 空なら %LOCALAPPDATA%、揮発するコンテナでは : /keys
    "DataProtectionKeyPath": "",

    // 配備で切り替えるもの（net10.0 版だけ）。
    
    // on で HTTP を HTTPS へリダイレクト（ポートも決める。ASPNETCORE_HTTPS_PORT は**単数**）
    "UseHttpsRedirection": "",
    // always で Cookie に Secure 属性を必ず付ける（平文 HTTP の環境で付けるとサインインできなくなる）
    "CookieSecurePolicy": "",
    // on で X-Forwarded-Proto / -For を取り込む（前段で TLS を終端する構成。詐称を許すので、アプリを直に叩ける環境では使わない）
    "UseForwardedHeaders": "",
    // 信用する前段のアドレス（カンマ区切り、空なら範囲を制限しない）
    "ForwardedHeadersKnownProxies": "",

    // Notification Provider
    // Smtp
    "SmtpHostName": "[e.g. : smtp.gmail.com]",
    "SmtpPortNo": "587",
    "SmtpSSL": "true",
    "SmtpAccountUID": "[xxxxx@gmail.com]",
    "SmtpAccountPWD": "[password of xxxxx@gmail.com]",
    // Twilio
    "TwilioAccountSid": "[TwilioAccountSid]",
    "TwilioAuthToken": "[TwilioAuthToken]",
    "TwilioFromPhoneNumber": "[TwilioFromPhoneNumber]",
    // Firebase Cloud Messaging (FCM)
    "FirebaseServiceAccountKey": "C:/root/files/resource/MultiPurposeAuthSite/FirebaseServiceAccountKey.json",
    // テスト用 : 設定すると、プッシュ通知を FCM に送らず、このディレクトリにファイルとして書く。本番では空のまま
    "FcmOutboxDirectory": "",

    // UserListCount
    "UserListCount": "50",
    // 約款画面を表示するかどうか
    "DisplayAgreementScreen": "false",
    // 文面ファイルのフォルダ
    "ContentOfLetterFilePath": "C:/root/files/resource/MultiPurposeAuthSite/Txt",

    // 本サイトでSaltとして機能する値：PPID生成に使用するSalt、外部ログイン追加時のXSRF防止
    "SaltParameter": "[Please set a random string for each site.]",

    // Administrator（システム管理者のアカウント）
    "AdministratorUID": "[Please fill in this input item.]",
    "AdministratorPWD": "[Please fill in this input item.]", // PWDのみ、初期化後削除可能

    // TestUser
    // password
    "TestUserPWD": "[password of TestUser]",
    // 接尾辞（#260）。E2E（test.ps1）が、サイトごとに _core / _netfx を与える。
    "TestUserSuffix": "",

    // User関連
    "AllowOnlyAlphanumericUserNames": "false",
    // メアド検証リンクの有効期限 24  時間
    "EmailConfirmationTokenLifespanFromHours": "24",
    // UserNameの編集を許可するかどうか
    "AllowEditingUserName": "true",
    // UserNameとEmail編集時にパスワードを要求するかどうか
    "RequirePasswordInEditingUserNameAndEmail": "false",
    // パスワード検証（8文字以上の大文字・小文字、数値、記号
    "RequiredLength": "8",
    "RequireNonLetterOrDigit": "true",
    "RequireDigit": "true",
    "RequireLowercase": "true",
    "RequireUppercase": "true",
    "StretchCount": "1000",
    // ロックアウト（5 回入力ミスすると、5分ロックアウト
    "UserLockoutEnabledByDefault": "true",
    "DefaultAccountLockoutTimeSpanFromSeconds": "300",
    "MaxFailedAccessAttemptsBeforeLockout": "5",
    
    // その他、属性の編集を許可するかどうか
    "CanEditEmail": "true",
    "CanEditPhone": "true",
    "CanEdit2FA": "true",
    "CanEditUnstructuredData": "true",
    "CanEditSaml2OAuth2Data": "true",
    "CanUseGdprFunction": "true",
    
    //  Cookie の名前に付ける接頭辞（同じホストに 2 つ立てるときだけ指定
    "CookieNamePrefix": "",
    // 認証 Cookie の名前**（#250 の段階 4）空なら既定のまま
    // net48 : .AspNet.ApplicationCookie, net10.0 : .AspNetCore.Identity.Application
    "AuthCookieName": "",
    // Cookie認証チケットの有効期限は2週間 24 * 14 = 336 時間
    "AuthCookieExpiresFromHours": "336",
    // Cookie認証チケットのSliding（再発行）機能
    "AuthCookieSlidingExpiration": "true",
    // 2FA : TwoFactorAuthentication
    // 必要に応じてユーザが有効にするので初期値は false
    "TwoFactorEnabled": "false",
    // 2FA Cookieの有効期限は2週間 24 * 14 = 336 時間
    "TwoFactorCookieExpiresFromHours": "336",
    // SecurityStamp（検証間隔は10秒、本番は長めに設定
    "SecurityStampValidateIntervalFromSeconds": "10",

    // FIDOServerMode: none, webauthn
    //   **net10.0 版だけの設定**（#137）。net48 版にはこのキーが無い。
    //   **mspass（Microsoft Passport）は落とした**（前身 API で、動く環境が無い）。
    "FIDOServerMode": "webauthn",

    // STS (SAML2, OAuth2/OIDC, FAPI)
    "IssuerId": "https://ssoauth.opentouryo.com",

    // Grant Typeの有効・無効
    "EnableAuthorizationCodeGrantType": "true",
    "EnableImplicitGrantType": "false",
    "EnableResourceOwnerPasswordCredentialsGrantType": "false",
    "EnableClientCredentialsGrantType": "true",
    "EnableJwtBearerTokenFlowGrantType": "true",
    "EnableDeviceAuthZGrantType": "true",
    "EnableCibaGrantType": "true",
    "EnableRefreshToken": "true",

    // OIDC を有効にするか
    "EnableOpenIDConnect": "true",

    // **動的クライアント登録（RFC 7591）を開けるか**（#307 の段階 1）。
    //   **既定は false**（**口そのものを張らない**。開けると /register が出来て、
    //   Discovery に registration_endpoint が載る）。
    //   **使うには ROPC も開ける必要がある**
    //   （EnableResourceOwnerPasswordCredentialsGrantType。管理 API 用の
    //   アクセス トークンは ROPC で取る）。
    //   **専用 scope（client_registration）を、構成ファイルか管理画面の
    //   クライアント登録に明記したクライアントだけが使える。**
    "EnableDynamicClientRegistration": "false",
    "DcrRegistrationEndpoint": "/register",
    //   **管理 API 専用のアクセス トークンの有効期限（秒）。**
    //     **未設定・0 以下なら 300 秒**（CI から叩く想定で、長く持たせる理由が無い）。
    "DcrAccessTokenExpireTimeSpanFromSeconds": "300",
    // **software_statement（RFC 7591 2.3）の発行者**（#307 の段階 4）。
    //   **「発行者ごと」である。** **クライアントごとではない**
    //   （**クライアント自身の鍵**は、動的登録の jwks か管理画面に入れる。段階 3）。
    //   **1 つのソフトウェアに 1 枚配られ、その全ての配置が同じものを提示する**ので、
    //   **登録が何件になっても、検証鍵は発行者 1 件につき 1 つ**である。
    //
    //   **1 件も書かなければ、software_statement は受け付けない**
    //   （**従来どおり unapproved_software_statement**）。
    //   **EnableDynamicClientRegistration が false の間は、この設定は効かない**
    //   （**口そのものが張られていない**）。
    //
    //   issuer        : **期待する iss**（statement の iss。**完全一致**）
    //   cer_file_path : **署名を検証する証明書**（**公開鍵だけで足りる**）
    //   alg           : **ヘッダの alg と照合する**（空なら RS256）
    //   enabled       : 空・未設定は true
    //
    //   "SoftwareStatementIssuers": {
    //     "vendor1": {
    //       "display_name": "Vendor 1", "enabled": "true",
    //       "issuer": "https://vendor.opentouryo.com",
    //       "cer_file_path": "C:/root/files/resource/X509/SHA256RSA_Client.cer",
    //       "alg": "RS256"
    //     }
    //   },
    //
    //   **E2E では test.ps1 が環境変数で渡す**（RT-307.18 〜 .21）。
    //     net10.0 : appSettings__SoftwareStatementIssuers__<鍵>__<属性>
    //     net48   : SoftwareStatementIssuers（1 本の JSON 文字列）
    //
    // **動的クライアント登録に software_statement を必須とするか**（#307 の段階 4）。
    //   **既定は false**（**従来どおり、添えなくても登録できる**）。
    //   **true にすると「審査を通したソフトウェアだけ登録させる」配備になる。**
    //   **POST /register と PUT（RFC 7592）の両方に効く** —
    //   **PUT に効かせないと、statement を省いて、主張された値を書き換えられる。**
    //   **信頼する発行者を 1 件も書かずに true にすると、動的登録は通らなくなる。**
    "RequireSoftwareStatement": "false",
    // PKCE を必須にするか（OAuth 2.1 は true）
    "RequirePkce": "false",
    // PKCE で S256 だけを受け付けるか（OAuth 2.1 / FAPI は true）
    "RequirePkceS256": "false",

    "OAuth2AuthorizationCodeExpireTimeSpanFromSeconds": "600",
    "RequestObjectExpireTimeSpanFromSeconds": "300",
    "OAuth2AccessTokenExpireTimeSpanFromMinutes": "360",
    "OAuth2RefreshTokenExpireTimeSpanFromDays": "14",
    "OidcIdTokenExpireTimeSpanFromMinutes": "30",
    "Saml2AssertionExpireTimeSpanFromMinutes": "30",
    "DeviceAuthZExpireTimeSpanFromSeconds": "600",
    "DeviceAuthZPollingIntervalSeconds": "5",
    "CibaExpireTimeSpanFromSeconds": "600",
    "CibaPollingIntervalSeconds": "5",
    // **ポーリングが interval より速いとき slow_down を返すか**（#305 の段階 1）。
    //   **未設定は true**（RFC 8628 §3.5 / CIBA §11 のとおり）。
    //   **false にすると従来どおり** authorization_pending を返し続ける。
    "EnablePollingSlowDown": "true",
    // **認証の失敗を数えて、一定回数で一定時間断る**（#305 の段階 2）。
    //   **0（または未設定）なら数えない**（従来どおり）。
    //   **クライアント認証**（client_secret / private_key_jwt）と
    //   **user_code の投入**が対象（利用者のパスワードは
    //   MaxFailedAccessAttemptsBeforeLockout 側で既に数えている）。
    "AuthFailureMaxAttempts": "5",
    "AuthFailureLockoutSeconds": "300",
    //   **数えた分を覚えている長さ**（#305 の段階 4）。
    //     **未設定なら AuthFailureLockoutSeconds と同じ。**
    //     **行の寿命もこれで決まる**（期限の過ぎた行は掃除される）。
    "AuthFailureWindowSeconds": "300",

    // **口ごとのレート制限**（#305 の段階 3）。
    //   **窓の中の要求の回数を数え、超えた分に 429（Retry-After）を返す。**
    //   **0（または未設定）なら制限しない**（従来どおり）。
    //   **client_id ごと**（洪水を起こしたクライアントだけを止める）と
    //   **送信元アドレスごと**（client_id を毎回変えても効く）の 2 つを数える。
    //   **プロセスの中に覚える**ので、**インスタンスを増やすとその数だけ緩くなる。**
    "RateLimitPerClientPermits": "120",
    "RateLimitPerIpPermits": "600",
    "RateLimitWindowSeconds": "60",

    // AuthorizationServerエンドポイント
    "OAuth2AuthorizationServerEndpointsRootURI": "https://localhost:44300/MultiPurposeAuthSite",
    // 認可エンドポイント
    "OAuth2AuthorizeEndpoint": "/authorize",
    "Saml2RequestEndpoint": "/saml2request",
    // Tokenエンドポイント
    "OAuth2TokenEndpoint": "/token",
    // その他のエンドポイント
    "OAuth2UserInfoEndpoint": "/userinfo",
    "OAuth2RevokeTokenEndpoint": "/revoke",
    "OAuth2IntrospectTokenEndpoint": "/introspect",
    // RP-Initiated Logout
    "OAuth2EndSessionEndpoint": "/end_session",
    // Device AuthZ
    "DeviceAuthZAuthorizeEndpoint": "/device_authz",
    "DeviceAuthZVerifyEndpoint": "/device_verify",
    // CIBA
    "CibaAuthorizeEndpoint": "/ciba_authz",
    "CibaPushResultEndpoint": "/ciba_result",
    
    // SAML, JWTの署名に使用する X.509 証明書に関するパラメタ
    "RsaPfxPassword": "test",
    "RsaPfxFilePath": "C:/root/files/resource/X509/SHA256RSA_Server.pfx",
    "EcdsaPfxPassword": "test",
    "EcdsaPfxFilePath": "C:/root/files/resource/X509/SHA256ECDSA_Server.pfx",
    // ES384 / ES512 は曲線が alg に紐づくので、鍵が分かれる（#129 の段階 3）
    "Ecdsa384PfxPassword": "test",
    "Ecdsa384PfxFilePath": "C:/root/files/resource/X509/SHA384ECDSA.pfx",
    "Ecdsa512PfxPassword": "test",
    "Ecdsa512PfxFilePath": "C:/root/files/resource/X509/SHA521ECDSA.pfx",
    "JwkSetFilePath": "C:/root/files/resource/MultiPurposeAuthSite/JwkSet.json",
    // **/jwkcerts の Cache-Control: public, max-age=（秒）**（#303。E-7）。
    //   **0（または未設定）なら no-store**（従来どおり）。
    //   **鍵を入れ替える周期より短くすること**（入れ替え直後は、この秒数の間だけ
    //   古い鍵を見る相手が居る。出す側は新旧 2 本を広告する。#291 / #292 の段階 3）。
    "JwkSetCacheMaxAgeSeconds": "300",

    // プッシュ通知
    "SetDeviceTokenWebAPI": "/SetDeviceToken",
    "TwoFactorPushResultEndpoint": "/2fa_result",
    // HybridFlowのテスト用
    "TestHybridFlowWebAPI": "/TestHybridFlowWebAPI",

    // **CORS で追加して許可するオリジン**（任意。#265）。**空でよい。**
    //   既定では、**構成ファイルの public クライアントの redirect_uri_* からオリジンを導く。**
    //   ここは、その導出で拾えないものを足すための口（空白かカンマ区切り）。
    //   **末尾の「/」は付けない。「*」は書かない**（落とすので許可されない）。
    "CorsAllowedOrigins": "",

    // コンテナ内で自己テストがバックチャンネルを呼ぶ場合
    "OAuth2ContainerizatedAuthSvrFqdnAndPort": "", // ホスト名とポートだけ差し替える（スキームは元のまま）
    "OAuth2ContainerizatedAuthSvrEPRootURI": "",   // スキームごと差し替える（HTTP のループバックにできる）

    // 外部ログイン

    // **外部 ID を既存アカウントに結び付けるとき、検証済みのメアドを要求する**（#140 の段階 1）。
    //   未設定でも true（安全側）。false にすると従来どおり（上流の言い値のメアドで結び付ける）。
    "RequireVerifiedEmailForAccountLinking": "true",
    // 外部ログイン（MicrosoftAccountAuthentication）
    "MicrosoftAccountAuthentication": "false",
    "MicrosoftAccountAuthenticationClientId": "[If necessary, please fill in ClientId of Microsoft Account]",
    "MicrosoftAccountAuthenticationClientSecret": "[If necessary, please fill in ClientSecret of Microsoft Account]",
    // 外部ログイン（GoogleAuthentication）
    "GoogleAuthentication": "false",
    "GoogleAuthenticationClientId": "[If necessary, please fill in ClientId of Google Authentication]",
    "GoogleAuthenticationClientSecret": "[If necessary, please fill in ClientSecret of Google Authentication]",
    // **Facebook / Twitter のサポートは取り下げた**（#249）。
    //   **動かないからではなく、維持コストが便益に見合わないため。**
    //   **アプリ側の登録はコメントアウトしてあるので、true にしても有効にならない。**
    //   キーだけ残してあるのは、判断が変わったときに戻せるようにするため。
    // 外部ログイン（FacebookAuthentication）
    "FacebookAuthentication": "false",
    "FacebookAuthenticationClientId": "[If necessary, please fill in ClientId of Facebook Authentication]",
    "FacebookAuthenticationClientSecret": "[If necessary, please fill in ClientSecret of Facebook Authentication]",
    // 外部ログイン（TwitterAuthentication）
    "TwitterAuthentication": "false",
    "TwitterAuthenticationClientId": "[If necessary, please fill in ClientId of Twitter Authentication]",
    "TwitterAuthenticationClientSecret": "[If necessary, please fill in ClientSecret of Twitter Authentication]",

    // IDフェデレーション
    // 既定値はコンテナ、E2Eは、環境変数で上書き。
    
    // 値は、上流の /openid-configuration から引ける。
    // 上流の JWK Set（書けば discovery を読まない。#290）
    "IdFederationJwkSetUri": "",
    // discovery（空なら IdFederationAuthorizeEndpoint の基底から組み立てる。#289）
    "IdFederationOidcDiscoveryUrl": "https://localhost:44301/.well-known/openid-configuration",
    // 認可エンドポイント
    "IdFederationAuthorizeEndpoint": "https://localhost:44301/authorize",
    // Redirectエンドポイント
    "IdFederationRedirectEndpoint": "https://localhost:44300/MultiPurposeAuthSite/Account/IDFederationRedirectEndPoint",
    // Tokenエンドポイント
    "IdFederationTokenEndpoint": "https://localhost:44301/token",
    // UserInfoエンドポイント
    "IdFederationUserInfoEndpoint": "https://localhost:44301/userinfo",
    // 上流の署名を検証する証明書
    "IdFederationOidcCerFilePath": "C:/root/files/resource/X509/SHA256RSA_Server.cer",

    // 値は、上流の /samlmetadata から引ける。
    // メタデータ（EntityDescriptor）。書けば SSO の口と署名証明書をここから引く（#291）
    "IdFederationSaml2MetadataUrl": "https://localhost:44301/samlmetadata",
    // Requestエンドポイント（メタデータから引けなければ、こちらを読む）
    "IdFederationSaml2RequestEndpoint": "https://localhost:44301/saml2request",
    // Responseエンドポイント
    "IdFederationSaml2ResponseEndpoint": "https://localhost:44300/MultiPurposeAuthSite/Account/IDFederationAssertionConsumerService",
    // 期待する上流の Issuer（上流の entityID）
    "IdFederationSaml2IssuerId": "https://ssoauth.opentouryo.com",
    // 上流の署名を検証する証明書
    "IdFederationSaml2CerFilePath": "C:/root/files/resource/X509/SHA256RSA_Server.cer",

    // user store に入る秘密を暗号化する鍵（#297）
    //   **空なら暗号化しない**（平文のまま入る ＝ 従来どおり）。
    //   **対象は `Saml2OAuth2Data.ClientSecret` と `IdFederationUpstreams.ClientSecret`。**
    //   **どちらも上流へ送る・画面で再表示する**ので、**ハッシュではなく対称鍵で暗号化する。**
    //   **設定ファイルの秘密は平文のまま**である（ここで守るのは「DB を見られたとき」）。
    //   **本番では、ここに直接書かないこと**（環境変数・秘密の管理機構から渡す）。
    "UserStoreSecretPassword": "",

    // 退役させる途中の署名証明書（#292 の段階 3）
    //   **/samlmetadata に並べて広告する。** **空なら 1 本だけ**（従来どおり）。
    //   **鍵を替える前に、新しい証明書をここに書いて広告する** → SP のキャッシュが切れたら
    //   **署名鍵を入れ替える**（RsaPfxFilePath / SpRp_RsaCerFilePath）→ **古い方をここに書く。**
    //   **区切りは空白かカンマ。** OIDC 側は JwkSet.json に新旧を並べる（この設定は使わない）。
    "PreviousSigningCerFilePaths": "",

    // 上流 IdP の登録（n 件。#292 の段階 1）
    //   **書けば、上の IdFederation* / SpRp_Isser / OAuth2AndOidcClientID より優先する。**
    //   **空なら、上の単数キーから 1 件が組み立てられる**（従来どおり）。
    //
    //   **鍵は短い識別子**（画面の導線の値・Session に控える値・ログに出る値）。
    //   **protocol は oidc / saml2。** **enabled は空なら有効。**
