         // 認証デバイスの web 版（PWA）。パブリック クライアント（client_secret なし。PKCE でトークンを交換する）（#205）。
         // redirect_uri_code は、flutter run -d chrome --web-port 5610 で起動したときの URL。
         "aad529f7f9b6428a84c59ac15aef0cdb": {
           "redirect_uri_code": "http://localhost:5610/",
           "client_name": "AuthenticationDevice_Web"
         },
         // 登録の scope で、要求してよいスコープを制限したクライアント（#198、E2E テスト用）。
         // scope は RFC 7591 の client metadata と同じく、スペース区切り。無ければ制限しない。
         "e9d6919296934542a33230fec2ebef31": {
           "client_secret": "8tjASfcfp4jYqoaauZuILw7D90MzxSEBz9xfO5JZhXc",
           "redirect_uri_code": "http://localhost:12346/",
           "client_name": "TestClient5",
           "scope": "openid profile email"
         },
         // このクライアントにだけ PKCE を必須にする（#221、E2E テスト用）。
         // サーバ全体の RequirePkce との OR で効く。クライアント側から緩めることはできない。
         // client_mode = fapi1 と違い、**PKCE 以外の経路は塞がない。**
         "c4309326f39b1e0975fddb4bc93b56a0": {
           "client_secret": "RW9WsvNoDe9Hu5CpqcWyvRBmZQnY8qHKWQgqaRhNXJQ",
           "redirect_uri_code": "test_self_code",
           "client_name": "TestClient6",
           "require_pkce": "true"
         }
       }
         ' />

  <!-- [DCR（WebAPI→DB）] -->
  <!-- **動的クライアント登録（RFC 7591）を開けるか**（#307 の段階 1）。
       **既定は false**（**口そのものを張らない**。開けると /register が出来て、
       Discovery に registration_endpoint が載る）。
       **管理 API 用のアクセス トークンは、ROPC か client_credentials で取る。**
       ROPC は EnableResourceOwnerPasswordCredentialsGrantType を開ける必要がある（所有者はその利用者）。
       client_credentials は EnableClientCredentialsGrantType が false でも、
       client_registration の scope だけは出す（所有者はクライアントの所有者）。
       **専用 scope（client_registration）を、構成ファイルか管理画面の
       クライアント登録に明記したクライアントだけが使える。** -->
  <add key="EnableDynamicClientRegistration" value="false" />
  <!-- **software_statement（RFC 7591 2.3）の発行者**（#307 の段階 4）
       **「発行者ごと」である。** **クライアントごとではない**
       （**クライアント自身の鍵**は、動的登録の jwks か管理画面に入れる。段階 3）。
       **1 つのソフトウェアに 1 枚配られ、その全ての配置が同じものを提示する**ので、
       **登録が何件になっても、検証鍵は発行者 1 件につき 1 つ**である。

       **空なら、software_statement は受け付けない**
       （**従来どおり unapproved_software_statement**）。
       **EnableDynamicClientRegistration が false の間は、この設定は効かない。**

       **OAuth2ClientsInformation と同じ流儀で、1 本の JSON 文字列**である。

       **cer_file_path は空白かカンマ区切りで n 本**書ける（#307 の段階 6）。
         **発行者の鍵の入れ替えのため**である。**入れ替えの間は新旧を並べて書き**、
         **済んだら古い方を消す**（**消すまでは古い鍵も有効**）。
         **試す順は書いた順**で、**1 本目以外で通ったときはログに残る**
         （**古い鍵をいつ消せるかの判断材料**）。
         **alg は行で 1 つ** — **鍵の種類や alg まで変える入れ替えは、この形では扱えない。**

       **allowed_scope / allowed_grant_types は、その発行者に許す上限**（#307 の段階 6）。
         **空（未設定）なら絞らない**（段階 4 までと同じ振る舞い）。
         **範囲外を主張されたら unapproved_software_statement で断る**（黙って狭めない）。
         **本文（plain JSON）に書かれた値も、この上限に収める** —
         **statement に書かれていなければ、本文の値が登録の値になる**ためである。
         **絞るのは「受け入れる側」の決め**で、
         **ベンダが自分で絞る分は statement の中身に書けば済む**（段階 4）。

       例 : {"vendor1":{"issuer":"...","cer_file_path":"a.cer b.cer","alg":"RS256",
             "allowed_scope":"openid email",
             "allowed_grant_types":"authorization_code refresh_token"}}
         issuer        : **期待する iss**（statement の iss。**完全一致**）
         cer_file_path : **署名を検証する証明書**（**公開鍵だけで足りる**）
         alg           : **ヘッダの alg と照合する**（空なら RS256）
         enabled       : 空・未設定は true

       value='{
         "vendor1":{
           "display_name":"Vendor 1",
           "enabled":"true",
           "issuer":"https://vendor.opentouryo.com",
           "cer_file_path":"C:/root/files/resource/X509/SHA256RSA_Client.cer",
           "alg":"RS256"
         }
       }'

       **1 行で書くこと** — **XML の属性値は、改行が空白へ畳まれる**（XML 1.0 3.3.3）。
       **E2E では test.ps1 が環境変数で渡す**（RT-307.18 〜 .21）。 -->
  <add key="SoftwareStatementIssuers" value="" />
  <!-- **動的クライアント登録に software_statement を必須とするか**（#307 の段階 4）
       **既定は false**（**従来どおり、添えなくても登録できる**）。
       **true にすると「審査を通したソフトウェアだけ登録させる」配備になる。**
       **POST /register と PUT（RFC 7592）の両方に効く** —
       **PUT に効かせないと、statement を省いて、主張された値を書き換えられる。**
       **信頼する発行者を 1 件も書かずに true にすると、動的登録は通らなくなる。** -->
  <add key="RequireSoftwareStatement" value="false" />

  <!-- [Discovery] -->
  <!-- Discovery の service_documentation **空なら Discovery に出さない**（任意の項目） -->
  <add key="ServiceDocumentation" value="" />

  <!-- ==== STS（防御） : Config.Sts.Protection.cs ==== -->
  <!-- [認証の失敗回数] -->
  <!-- **認証の失敗を数えて、一定回数で一定時間断る**（#305 の段階 2）。
       **0（または未設定）なら数えない**（従来どおり）。 -->
  <add key="AuthFailureMaxAttempts" value="5" />
  <add key="AuthFailureLockoutSeconds" value="300" />
  <!-- **数えた分を覚えている長さ**（#305 の段階 4）。
       **未設定なら AuthFailureLockoutSeconds と同じ。** -->
  <add key="AuthFailureWindowSeconds" value="300" />

  <!-- [レート制限] -->
  <!-- **口ごとのレート制限**（#305 の段階 3）。
       **窓の中の要求の回数を数え、超えた分に 429（Retry-After）を返す。**
       **0（または未設定）なら制限しない**（従来どおり）。 -->
  <add key="RateLimitPerClientPermits" value="120" />
  <add key="RateLimitPerIpPermits" value="600" />
  <add key="RateLimitWindowSeconds" value="60" />

  <!-- [メールの送り過ぎ] -->
  <!-- **メアド検証・パスワード リセットのメールを、1 人に送る間隔（秒）**（#294）。
       **同じ利用者・同じ用途のメールは、この間隔に 1 通まで**（画面は変えない）。
       **0（または未設定）なら絞らない**（従来どおり）。 -->
  <add key="MailResendIntervalSeconds" value="60" />

  <!-- [ポーリングの slow_down] -->
  <!-- **ポーリングが interval より速いとき slow_down を返すか**（#305 の段階 1）。
       **未設定は true**。**false にすると従来どおり。** -->
  <add key="EnablePollingSlowDown" value="true" />

  <!-- ==== STS（口） : Config.Sts.Endpoints.cs ==== -->
  <!-- [基底] -->
  <!-- AuthorizationServerエンドポイント -->
  <add key="OAuth2AuthorizationServerEndpointsRootURI" value="https://localhost:44300/MultiPurposeAuthSite" />

  <!-- コンテナ内で自己テストがバックチャンネルを呼ぶ場合 -->
  <add key="OAuth2ContainerizatedAuthSvrEPRootURI" value="" /> <!-- スキームごと差し替える（HTTP のループバックにできる） -->
  <add key="OAuth2ContainerizatedAuthSvrFqdnAndPort" value="" /> <!-- ホスト名とポートだけ差し替える（スキームは元のまま） -->

  <!-- [SAML2] -->
  <add key="Saml2RequestEndpoint" value="/saml2request" />
  <!-- - test_self_saml : AssertionConsumerService -->
  <add key="Saml2ResponseEndpoint" value="/Account/AssertionConsumerService" />

  <!-- [OAuth2/OIDC] -->
  <!-- 認可エンドポイント -->
  <add key="OAuth2AuthorizeEndpoint" value="/authorize" />
  <!-- Tokenエンドポイント -->
  <add key="OAuth2TokenEndpoint" value="/token" />
  <!-- RP-Initiated Logout -->
  <add key="OAuth2EndSessionEndpoint" value="/end_session" />

  <!-- [WebAPI] -->
  <add key="OAuth2UserInfoEndpoint" value="/userinfo" />
  <add key="OAuth2RevokeTokenEndpoint" value="/revoke" />
  <add key="OAuth2IntrospectTokenEndpoint" value="/introspect" />
  <add key="DcrRegistrationEndpoint" value="/register" />

  <!-- [その他の WebAPI] -->
  <!-- HybridFlowのテスト用 -->
  <add key="TestHybridFlowWebAPI" value="/TestHybridFlow" />

  <!-- プッシュ通知 -->
  <add key="SetDeviceTokenWebAPI" value="/SetDeviceToken" />
  <add key="TwoFactorPushResultEndpoint" value="/2fa_result" />

  <!-- [Device AuthZ] -->
  <add key="DeviceAuthZAuthorizeEndpoint" value="/device_authz" />
  <add key="DeviceAuthZVerifyEndpoint" value="/device_verify" />

  <!-- [CIBA Core] -->
  <add key="CibaAuthorizeEndpoint" value="/ciba_authz" />
  <add key="CibaPushResultEndpoint" value="/ciba_result" />

  <!-- [自己テスト] -->
  <!-- テスト用Clientエンドポイント -->
  <add key="OAuth2ClientEndpointsRootURI" value="https://localhost:44300/MultiPurposeAuthSite" />
  <!-- - test_self_code : Authorization Codeグラント種別 -->
  <add key="OAuth2AuthorizationCodeGrantClient_Account" value="/Account/OAuth2AuthorizationCodeGrantClient" />
  <!-- - test_self_token : Implicitグラント種別 -->
  <add key="OAuth2ImplicitGrantClient_Account" value="/Account/OAuth2ImplicitGrantClient" />
  <!-- Redirectエンドポイント（テスト用）のロックダウン -->
  <add key="IsLockedDownTestEndpoints" value="false" />

  <!-- ==== ID 連携 : Config.IdFederation.cs ==== -->
  <!-- [折り返し口] -->
  <!-- 既定値はコンテナ、E2Eは、環境変数で上書き。 -->
  <!-- Redirectエンドポイント -->
  <add key="IdFederationRedirectEndpoint" value="https://localhost:44300/MultiPurposeAuthSite/Account/IDFederationRedirectEndPoint" />
  <!-- Responseエンドポイント -->
  <add key="IdFederationSaml2ResponseEndpoint" value="https://localhost:44300/MultiPurposeAuthSite/Account/IDFederationAssertionConsumerService" />

  <!-- [複数キー（上流 IdP の登録 n 件）] -->
  <!-- 上流 IdP の登録（n 件。#292 の段階 1）
       **1 件でも書けば、下の単数キー（IdFederation*）は読まれない。**
       **上流の値として SpRp_Isser / OAuth2AndOidcClientID / OAuth2AndOidcSecret も使わない**
       （各行の issuer / client_id / client_secret を使う）。
       **空なら、下の単数キーから OIDC・SAML2 の各 1 件が組み立てられる**（下位互換）。
       管理画面（user store）の行は、どちらの場合も後ろに足される（同じ鍵なら設定が勝つ。#292 の段階 2）。

       **discovery_url / jwk_set_uri / *_endpoint は、上流（相手）の口**である。
       **自分の口（JwkSetUri = /jwkcerts など。自分の discovery で広告する）とは別。**

       **OAuth2ClientsInformation と同じ流儀で、1 本の JSON 文字列**である。
       **折り返し口（IdFederationRedirectEndpoint / …Saml2ResponseEndpoint）は共通設定のまま。**

       value='{
         "upstream1":{
           "display_name":"Upstream IdP (OIDC)",
           "protocol":"oidc",
           "enabled":"true",
           "issuer":"https://ssoauth.opentouryo.com",
           "client_id":"06d20f595b694114b710c1d85e21bb8e",
           "client_secret":"...",
           "discovery_url":"https://localhost:44301/.well-known/openid-configuration",
           "jwk_set_uri":"",
           "cer_file_path":"C:/root/files/resource/X509/SHA256RSA_Server.cer",
           "authorize_endpoint":"https://localhost:44301/authorize",
           "token_endpoint":"https://localhost:44301/token",
           "userinfo_endpoint":"https://localhost:44301/userinfo"
         },
         "upstream1_saml2":{
           "display_name":"Upstream IdP (SAML2)",
           "protocol":"saml2",
           "issuer":"https://ssoauth.opentouryo.com",
           "client_id":"06d20f595b694114b710c1d85e21bb8e",
           "metadata_url":"https://localhost:44301/samlmetadata",
           "sso_endpoint":"https://localhost:44301/saml2request",
           "cer_file_path":"C:/root/files/resource/X509/SHA256RSA_Server.cer",
           "signing_pfx_file_path":"",
           "signing_pfx_password":""
         }
       }'

       **signing_pfx_* は、この上流へ送る AuthnRequest に署名する鍵**（#292 の段階 4-a）。
       **空なら共通設定**（SpRp_RsaPfxFilePath / SpRp_RsaPfxPassword）。
  -->
  <add key="IdFederationUpstreams" value="" />

  <!-- [単数キー（上流 IdP の登録 1 件。互換） / OIDC] -->
  <!-- **IdFederationUpstreams を書くと、この節は読まれない**（下位互換）。
       期待する上流の iss は SpRp_Isser、client_id / client_secret は OAuth2AndOidcClientID / OAuth2AndOidcSecret を使う。 -->
  <!-- 値は、上流の /openid-configuration から引ける。 -->
  <!-- discovery（空なら IdFederationAuthorizeEndpoint の基底から組み立てる。#289） -->
  <add key="IdFederationOidcDiscoveryUrl" value="https://localhost:44301/.well-known/openid-configuration" />
  <!-- 認可エンドポイント -->
  <add key="IdFederationAuthorizeEndpoint" value="https://localhost:44301/authorize" />
  <!-- Tokenエンドポイント -->
  <add key="IdFederationTokenEndpoint" value="https://localhost:44301/token" />
  <!-- UserInfoエンドポイント -->
  <add key="IdFederationUserInfoEndpoint" value="https://localhost:44301/userinfo" />
  <!-- 上流の JWK Set（書けば discovery を読まない。#290）。**自分の JwkSetUri（/jwkcerts）とは別** -->
  <add key="IdFederationJwkSetUri" value="" />
  <!-- 上流の署名を検証する証明書 -->
  <add key="IdFederationOidcCerFilePath" value="C:/root/files/resource/X509/SHA256RSA_Server.cer" />

  <!-- [単数キー（上流 IdP の登録 1 件。互換） / SAML2] -->
  <!-- **IdFederationUpstreams を書くと、この節は読まれない**（下位互換）。client_id は OAuth2AndOidcClientID を使う。 -->
  <!-- 値は、上流の /samlmetadata から引ける。 -->
  <!-- メタデータ（EntityDescriptor）。書けば SSO の口と署名証明書をここから引く（#291） -->
  <add key="IdFederationSaml2MetadataUrl" value="https://localhost:44301/samlmetadata" />
  <!-- Requestエンドポイント（メタデータから引けなければ、こちらを読む） -->
  <add key="IdFederationSaml2RequestEndpoint" value="https://localhost:44301/saml2request" />
  <!-- 期待する上流の Issuer（上流の entityID） -->
  <add key="IdFederationSaml2IssuerId" value="https://ssoauth.opentouryo.com" />
  <!-- 上流の署名を検証する証明書 -->
  <add key="IdFederationSaml2CerFilePath" value="C:/root/files/resource/X509/SHA256RSA_Server.cer" />

  <!-- Client-Server共通設定 ========================================================== -->
  <!-- 自分の JWK Set の口のパス。discovery の jwks_uri は OAuth2AuthorizationServerEndpointsRootURI ＋ このパス。
       **ID 連携の上流の JWK Set ではない**（そちらは jwk_set_uri / IdFederationJwkSetUri）。
       （Open棟梁 の JwkSetStore はこれを完全な URL として読むが、JwkSetFilePath が在る MPAS では通らない） -->
  <add key="JwkSetUri" value="/jwkcerts"/>
  <!-- Request Object を預ける独自の口（RFC 9101 5.2.1） -->
  <add key="RequestObjectRegUri" value="/ros" />
  <!-- 認可リクエストを先に預ける口（PAR：RFC 9126） -->
  <add key="AuthRequestPushUri" value="/par" />
  <!-- Token検証用（JWKの控えとしても使用）
       ID 連携で上流の鍵が決まらないとき（1:1 の構成の名残）の検証にも使う（期待する iss は SpRp_Isser）。 -->
  <add key="SpRp_RsaCerFilePath" value="C:\root\files\resource\X509\SHA256RSA_Server.cer"/>
  <add key="SpRp_EcdsaCerFilePath" value="C:\root\files\resource\X509\SHA256ECDSA_Server.cer"/>
  <add key="SpRp_Ecdsa384CerFilePath" value="C:\root\files\resource\X509\SHA384ECDSA.cer"/>
  <add key="SpRp_Ecdsa512CerFilePath" value="C:\root\files\resource\X509\SHA521ECDSA.cer"/>
  <!-- ================================================================================ -->

  <!-- Client側設定 =================================================================== -->
  <add key="OAuth2AndOidcClientID" value="06d20f595b694114b710c1d85e21bb8e"/>
  <add key="OAuth2AndOidcSecret" value="ld47EVKDDkxleIup7Z0UQ1rVy_IR4q3lXamyNcrIUEo"/>
  <!-- 1 件設定の ID 連携では、期待する上流の iss にも使う（IdFederationUpstreams を書けば、上流の値としては使わない） -->
  <add key="SpRp_Isser" value="https://ssoauth.opentouryo.com"/>
  <!-- クライアント認証用 -->
