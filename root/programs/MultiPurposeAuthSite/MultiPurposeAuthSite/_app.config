           "client_name": "TestClient4",
           "jwk_ecdsa_publickey": "eyJrdHkiOiJFQyIsImFsZyI6IkVTMjU2IiwiY3J2IjoiUC0yNTYiLCJ4IjoiUUhxUmdNZHdBN0RlbUFMM09yVE1NVU9QczZkdkxMaWd1UVlSVHY4SWFybyIsInkiOiJsNlAyVEVxeng1Z19TMkEzQ1BUYXNTY00zZFM4RHQtS1lCWTNXQ0FSeENFIiwia2lkIjoiMWhPa2thNVJHVGZDbHUyS3JFSEVTcmRHcmlseC1OUzVFT3pWZ1M1Sk12TSJ9"
         },
         "06d20f595b694114b710c1d85e21bb8e": {
           "client_secret": "ld47EVKDDkxleIup7Z0UQ1rVy_IR4q3lXamyNcrIUEo",
           "redirect_uri_code": "https://localhost:44300/MultiPurposeAuthSite/Account/IDFederationRedirectEndPoint",
           "redirect_uri_saml": "https://localhost:44300/MultiPurposeAuthSite/Account/IDFederationAssertionConsumerService",
           "redirect_uri_token": "-",
           "client_name": "IdFederation"
         },
         "f53469c17c5a432f86ce563b7805ab89": {
           "client_secret": "cKdwJb6mRKVIJpGxEWjIC94zquQltw_ECfO-55p21YM",
           "redirect_uri_code": "https://localhost:44334/Home/OAuth2AuthorizationCodeGrantClient",
           "redirect_uri_token": "hogehoge0",
           "client_name": "MVC_Sample"
         },
         "b6b393fe861b430eb4ee061006826b03": {
           "client_secret": "p2RgAFKF-JaF0A9F1tyDXp4wMq-uQZYyvTBM8wr_v8g",
           "redirect_uri_code": "https://localhost:44333/WebForms_Sample/Aspx/OAuth2/OAuth2AuthorizationCodeGrantClient.aspx",
           "redirect_uri_token": "hogehoge1",
           "client_name": "WebForms_Sample"
         },
         "f374a155909d486a9234693c34e94479": {
           "client_secret": "z54lhkewWPl4hk3eF1WYwvdqt7Fz24jYamLPZFVnWpA",
           "redirect_uri_code": "http://localhost:3000/RedirectEndpoint",
           "redirect_uri_token": "",
           "client_name": "SPA_Application"
         },
         "40319c0100f94ff3aab3004c8bdb5e52": {
           "client_secret": "m7VUuKLCK1nODl3xrLSoitw1x8N7sike9d5cXWa9_lg",
           "redirect_uri_code": "http://opentouryo.com/",
           "redirect_uri_token": "",
           "client_name": "Native_Application"
         },
         // 認証デバイスの web 版（PWA）。パブリック クライアント（client_secret なし。PKCE でトークンを交換する）（#205）。
         // redirect_uri_code は、flutter run -d chrome --web-port 5610 で起動したときの URL。
         "aad529f7f9b6428a84c59ac15aef0cdb": {
           "redirect_uri_code": "http://localhost:5610/",
           "client_name": "AuthenticationDevice_Web"
         },
         // 登録の scope で、要求してよいスコープを制限したクライアント（#198、E2E テスト用）。
         // scope は RFC 7591 の client metadata と同じく、スペース区切り。無ければ制限しない。
         "e9d6919296934542a33230fec2ebef31": {
           "client_secret": "8tjASfcfp4jYqoaauZuILw7D90MzxSEBz9xfO5JZhXc",
           "redirect_uri_code": "http://localhost:12346/",
           "client_name": "TestClient5",
           "scope": "openid profile email"
         },
         // このクライアントにだけ PKCE を必須にする（#221、E2E テスト用）。
         // サーバ全体の RequirePkce との OR で効く。クライアント側から緩めることはできない。
         // oauth2_oidc_mode = fapi1 と違い、**PKCE 以外の経路は塞がない。**
         "c4309326f39b1e0975fddb4bc93b56a0": {
           "client_secret": "RW9WsvNoDe9Hu5CpqcWyvRBmZQnY8qHKWQgqaRhNXJQ",
           "redirect_uri_code": "test_self_code",
           "client_name": "TestClient6",
           "require_pkce": "true"
         }
       }
         ' />

  <!-- profile / address のクレームの対応付け（#230） -->
  <!--   **「どのキーを、どのクレームとして返すか」だけを書く。** -->
  <!--   値の在り処は UnstructuredData（JSON）の中のパス（入れ子は「.」で辿る）か、 -->
  <!--   user:<項目>（UserName / Email / PhoneNumber のみ）。 -->
  <!--   クレーム名に「address.<副フィールド>」と書くと、address オブジェクトを組み立てる。 -->
  <!--   **空なら profile / address では何も返らない**（従来どおり）。 -->
  <!--   どのクレームがどの scope に属するかは OIDC Core 5.4 が決めており、ここには書かない。 -->
  <!--   例 : { "name": "fullName", "given_name": "person.first", "address.postal_code": "addr.zip" } -->
  <!--  -->
  <!--   **利用者名を RP に渡したいなら、ここで preferred_username に対応付ける**（#151 の段階 1）。 -->
  <!--     { "preferred_username": "user:UserName" } -->
  <!--   **sub は利用者を指す識別子なので、そこに利用者名を載せてはならない。** -->
  <!--   sub は「その RP の中で利用者を指す識別子」、preferred_username は「表示・照合用の属性」。 -->
  <!--   **RP が主キーに使ってよいのは sub だけ**で、preferred_username は変わりうる（改名）。 -->
  <!-- **標準クレームを返すときのサンプル**（#261）。**既定は空のまま**にしてある。 -->
  <!--   左がクレーム名（OIDC Core 5.1）、右が値の在り処。 -->
  <!--     ・`UnstructuredData`（JSON）の中のパス … `.` で辿る（例 : address.postal_code） -->
  <!--     ・`user:<項目>` … ApplicationUser から直に取る（UserName / Email / PhoneNumber） -->
  <!--   **IsDebug のとき、2 人目のテスト利用者（tanaka）に、この形の JSON が入る** -->
  <!--   （AccountController.SampleUnstructuredData）。 -->
  <!--  -->
  <!--   "UserClaimsMapping": { -->
  <!--     "name":                   "name", -->
  <!--     "family_name":            "family_name", -->
  <!--     "given_name":             "given_name", -->
  <!--     "nickname":               "nickname", -->
  <!--     "profile":                "profile", -->
  <!--     "picture":                "picture", -->
  <!--     "website":                "website", -->
  <!--     "gender":                 "gender", -->
  <!--     "birthdate":              "birthdate", -->
  <!--     "zoneinfo":               "zoneinfo", -->
  <!--     "locale":                 "locale", -->
  <!--     "updated_at":             "updated_at", -->
  <!--     "address.formatted":      "address.formatted", -->
  <!--     "address.street_address": "address.street_address", -->
  <!--     "address.locality":       "address.locality", -->
  <!--     "address.region":         "address.region", -->
  <!--     "address.postal_code":    "address.postal_code", -->
  <!--     "address.country":        "address.country", -->
  <!--     "preferred_username":     "user:UserName" -->
  <!--   } -->
  <!--  -->
  <!--   **管理画面で入れられるのは usd1 / usd2 の 2 欄だけ**である。 -->
  <!--   それ以外のキーは、**導入する側が入れる**（画面を足すか、別の経路で書く）。 -->
  <!--  -->
  <!--   **E2E だけは、name と address.locality を usd1 / usd2 に向けている**（test.ps1）。 -->
  <!--     **画面から入れた値が返ることを測り続けるため**である（RT-230.*）。 -->
  <!--     そのため **E2E の報告書には `name ← usd1` と出る。** 上のサンプルとは違う。 -->
  <add key="UserClaimsMapping" value="{}" />

  <!-- Client-Server共通設定 ========================================================== -->
  <add key="JwkSetUri" value="/jwkcerts"/>
  <!-- Request Object を預ける独自の口（RFC 9101 5.2.1） -->
  <add key="RequestObjectRegUri" value="/ros" />
  <!-- 認可リクエストを先に預ける口（PAR：RFC 9126） -->
  <add key="AuthRequestPushUri" value="/par" />
  <!-- Token検証用（JWKの控えとしても使用） -->
  <add key="SpRp_RsaCerFilePath" value="C:\root\files\resource\X509\SHA256RSA_Server.cer"/>
  <add key="SpRp_EcdsaCerFilePath" value="C:\root\files\resource\X509\SHA256ECDSA_Server.cer"/>
  <add key="SpRp_Ecdsa384CerFilePath" value="C:\root\files\resource\X509\SHA384ECDSA.cer"/>
  <add key="SpRp_Ecdsa512CerFilePath" value="C:\root\files\resource\X509\SHA521ECDSA.cer"/>
  <!-- ================================================================================ -->

  <!-- Client側設定 =================================================================== -->
  <add key="OAuth2AndOidcClientID" value="06d20f595b694114b710c1d85e21bb8e"/>
  <add key="OAuth2AndOidcSecret" value="ld47EVKDDkxleIup7Z0UQ1rVy_IR4q3lXamyNcrIUEo"/>
  <add key="SpRp_Isser" value="https://ssoauth.opentouryo.com"/>
  <!-- クライアント認証用 -->
  <add key="SpRp_RsaPfxPassword" value="test"/>
  <add key="SpRp_RsaPfxFilePath" value="C:\root\files\resource\X509\SHA256RSA_Client.pfx"/>
  <add key="SpRp_EcdsaPfxPassword" value="test"/>
  <add key="SpRp_EcdsaPfxFilePath" value="C:\root\files\resource\X509\SHA256ECDSA_Client.pfx"/>
  <!-- クライアント証明書 -->
  <add key="SpRp_ClientCertPfxPassword" value="test"/>
  <add key="SpRp_ClientCertPfxFilePath" value="C:\root\files\resource\X509\SHA256RSAClientCert.pfx"/>
  <!-- ================================================================================ -->

</appSettings>
