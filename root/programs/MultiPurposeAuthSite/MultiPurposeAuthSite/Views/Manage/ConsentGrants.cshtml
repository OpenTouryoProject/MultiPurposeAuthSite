@using MultiPurposeAuthSite.Resources
@using MultiPurposeAuthSite.ViewModels

@model ManageConsentGrantsViewModel

@{
    ViewBag.Title = ManageViews.ConsentGrantsTitle;
}

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title</h2>

<p class="text-success">@ViewBag.StatusMessage</p>

@if (Model.Grants.Count == 0)
{
    <p>@ManageViews.ConsentGrantsNone</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@ManageViews.ConsentGrantsClient</th>
                <th>@ManageViews.ConsentGrantsScopes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (ConsentGrantViewModel grant in Model.Grants)
            {
                <tr>
                    <td>@grant.ClientName</td>
                    <td>@grant.Scopes</td>
                    <td>
                        @using (Html.BeginForm("RevokeConsent", "Manage"))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="clientId" value="@grant.ClientId" />
                            <input type="submit" class="btn btn-default"
                                   value="@ManageViews.ConsentGrantsRevokeButton" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* スクリプト・セクション（RenderSection("FooterScriptsSection", required: true)に出力されます） *@
@section FooterScriptsSection{
    <!-- Footer 部の section -->
}
