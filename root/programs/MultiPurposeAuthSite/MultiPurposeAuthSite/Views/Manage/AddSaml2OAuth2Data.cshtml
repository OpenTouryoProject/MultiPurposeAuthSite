@using MultiPurposeAuthSite.Co
@using MultiPurposeAuthSite.Entity
@using MultiPurposeAuthSite.Resources
@using MultiPurposeAuthSite.ViewModels

@model ManageAddSaml2OAuth2DataViewModel
@{
    ViewBag.Title = ManageViews.AddSaml2OAuth2DataTitle;
}

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("AddSaml2OAuth2Data", "Manage", FormMethod.Post, new { @class = "form-horizontal", role = "form", onsubmit = "Fx_OnSubmit();" }))
{
    @Html.AntiForgeryToken()
    <h4>@ManageViews.AddSaml2OAuth2DataH4</h4>
    <hr />
    @Html.ValidationSummary("", new { @class = "text-danger" })
    @*
        **項目の並びと説明は #277 の段階 1 で整えた。**

        **説明は ViewModel に 1 か所だけ書く**（`[Display(Description = ...)]`）。
        **net48 版と net10.0 版で View を同じに保つ**ため、
        取り出し方の違いは `Html.DescriptionFor`（CommonLibrary）が吸収する。

        **並びの理屈** : 識別子 → 経路の決まり方 → 戻り先 → sub と CORS → 署名 → 鍵と証明書。
        **client_type は対象外**（ViewModel ごとコメント アウトされている。保存もされない）。
    *@
    <div class="form-group">
        @Html.LabelFor(m => m.ClientID, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            <div class="form-inline">
                <div class="input-group">
                    @Html.TextBoxFor(m => m.ClientID, new { @class = "form-control", @readonly = "readonly" })
                    <span class="input-group-btn">
                        <input type="submit" class="btn btn-primary" name="submit.ClientID" value="@ManageViews.IndexClientIDChangeButton" />
                    </span>
                </div>
            </div>
            <p class="help-block">@Html.DescriptionFor(m => m.ClientID)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.ClientSecret, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            <div class="form-inline">
                <div class="input-group">
                    @Html.TextBoxFor(m => m.ClientSecret, new { @class = "form-control", @readonly = "readonly" })
                    <span class="input-group-btn">
                        <input type="submit" class="btn btn-primary" name="submit.ClientSecret" value="@ManageViews.IndexClientSecretChangeButton" />
                    </span>
                </div>
            </div>
            <p class="help-block">@Html.DescriptionFor(m => m.ClientSecret)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.ClientMode, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @Html.DropDownListFor(model => model.ClientMode, Model.DdlClientModeItems, new { @class = "form-control" })
            <p class="help-block">@Html.DescriptionFor(m => m.ClientMode)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.RequirePkce, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @Html.CheckBoxFor(model => model.RequirePkce)
            <p class="help-block">@Html.DescriptionFor(m => m.RequirePkce)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.RedirectUriSaml, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @*  **既定値を選べるようにする**（#277 の段階 3）。
                **`<select>` ではない** — 自由に書けることも必要なので、
                `<input>` ＋ `<datalist>` の組み合わせにする。
                **候補は ViewModel が `Const` から引く**（画面とサーバで食い違わせない）。 *@
            @Html.TextBoxFor(m => m.RedirectUriSaml, new { @class = "form-control", @list = "list-RedirectUriSaml" })
            <datalist id="list-RedirectUriSaml">
                @foreach (string candidate in Model.RedirectUriSamlCandidates)
                {
                    <option value="@candidate"></option>
                }
            </datalist>
            <p class="help-block">@Html.DescriptionFor(m => m.RedirectUriSaml)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.RedirectUriCode, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @*  **既定値を選べるようにする**（#277 の段階 3）。
                **`<select>` ではない** — 自由に書けることも必要なので、
                `<input>` ＋ `<datalist>` の組み合わせにする。
                **候補は ViewModel が `Const` から引く**（画面とサーバで食い違わせない）。 *@
            @Html.TextBoxFor(m => m.RedirectUriCode, new { @class = "form-control", @list = "list-RedirectUriCode" })
            <datalist id="list-RedirectUriCode">
                @foreach (string candidate in Model.RedirectUriCodeCandidates)
                {
                    <option value="@candidate"></option>
                }
            </datalist>
            <p class="help-block">@Html.DescriptionFor(m => m.RedirectUriCode)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.RedirectUriToken, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @*  **既定値を選べるようにする**（#277 の段階 3）。
                **`<select>` ではない** — 自由に書けることも必要なので、
                `<input>` ＋ `<datalist>` の組み合わせにする。
                **候補は ViewModel が `Const` から引く**（画面とサーバで食い違わせない）。 *@
            @Html.TextBoxFor(m => m.RedirectUriToken, new { @class = "form-control", @list = "list-RedirectUriToken" })
            <datalist id="list-RedirectUriToken">
                @foreach (string candidate in Model.RedirectUriTokenCandidates)
                {
                    <option value="@candidate"></option>
                }
            </datalist>
            <p class="help-block">@Html.DescriptionFor(m => m.RedirectUriToken)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.PostLogoutRedirectUri, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @*  **既定値を選べるようにする**（#277 の段階 3）。
                **`<select>` ではない** — 自由に書けることも必要なので、
                `<input>` ＋ `<datalist>` の組み合わせにする。
                **候補は ViewModel が `Const` から引く**（画面とサーバで食い違わせない）。 *@
            @Html.TextBoxFor(m => m.PostLogoutRedirectUri, new { @class = "form-control", @list = "list-PostLogoutRedirectUri" })
            <datalist id="list-PostLogoutRedirectUri">
                @foreach (string candidate in Model.PostLogoutRedirectUriCandidates)
                {
                    <option value="@candidate"></option>
                }
            </datalist>
            <p class="help-block">@Html.DescriptionFor(m => m.PostLogoutRedirectUri)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.SubjectTypes, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @Html.DropDownListFor(model => model.SubjectTypes, Model.DdlSubjectTypesItems, new { @class = "form-control" })
            <p class="help-block">@Html.DescriptionFor(m => m.SubjectTypes)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.WebOrigins, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.WebOrigins, new { @class = "form-control" })
            <p class="help-block">@Html.DescriptionFor(m => m.WebOrigins)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.IdTokenSignedResponseAlg, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @Html.DropDownListFor(model => model.IdTokenSignedResponseAlg, Model.DdlIdTokenSignedResponseAlgItems, new { @class = "form-control" })
            <p class="help-block">@Html.DescriptionFor(m => m.IdTokenSignedResponseAlg)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.TokenEndpointAuthSigningAlg, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @Html.DropDownListFor(model => model.TokenEndpointAuthSigningAlg, Model.DdlTokenEndpointAuthSigningAlgItems, new { @class = "form-control" })
            <p class="help-block">@Html.DescriptionFor(m => m.TokenEndpointAuthSigningAlg)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.RequestObjectSigningAlg, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @Html.DropDownListFor(model => model.RequestObjectSigningAlg, Model.DdlRequestObjectSigningAlgItems, new { @class = "form-control" })
            <p class="help-block">@Html.DescriptionFor(m => m.RequestObjectSigningAlg)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.JwkRsaPublickey, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @Html.TextBoxFor(m => m.JwkRsaPublickey, new { @class = "form-control" })
            <p class="help-block">@Html.DescriptionFor(m => m.JwkRsaPublickey)</p>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.TlsClientAuthSubjectDn, new { @class = "col-md-2 control-label" })
        <div class="col-md-3">
            @Html.TextBoxFor(m => m.TlsClientAuthSubjectDn, new { @class = "form-control" })
            <p class="help-block">@Html.DescriptionFor(m => m.TlsClientAuthSubjectDn)</p>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" class="btn btn-primary" name="submit.Add" value="@ManageViews.AddSaml2OAuth2DataSubmit" />
        </div>
    </div>
}

@* スクリプト・セクション（RenderSection("FooterScriptsSection", required: true)に出力されます） *@
@section FooterScriptsSection{
