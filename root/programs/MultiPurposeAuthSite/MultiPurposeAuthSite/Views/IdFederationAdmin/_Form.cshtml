@using MultiPurposeAuthSite.ViewModels

@model IdFederationUpstreamViewModel

@*  **追加と編集で同じ欄**なので、1 か所に置く（**片方だけ直す事故を避ける**）。
    **項目は設定（appSettings の IdFederationUpstreams）と同じ**である。 *@
<div class="form-group">
    @Html.LabelFor(m => m.Protocol, new { @class = "col-md-3 control-label" })
    <div class="col-md-9">
        @Html.DropDownListFor(m => m.Protocol, new List<SelectListItem>()
        {
            new SelectListItem() { Text = "oidc", Value = "oidc" },
            new SelectListItem() { Text = "saml2", Value = "saml2" }
        }, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Protocol, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group">
    @Html.LabelFor(m => m.Enabled, new { @class = "col-md-3 control-label" })
    <div class="col-md-9">
        @Html.CheckBoxFor(m => m.Enabled)
    </div>
</div>
<div class="form-group">
    @Html.LabelFor(m => m.DisplayName, new { @class = "col-md-3 control-label" })
    <div class="col-md-9">
        @Html.TextBoxFor(m => m.DisplayName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.DisplayName, "", new { @class = "text-danger" })
    </div>
</div>
