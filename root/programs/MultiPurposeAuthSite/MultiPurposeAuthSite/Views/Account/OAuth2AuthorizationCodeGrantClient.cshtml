@using MultiPurposeAuthSite.Co
@using MultiPurposeAuthSite.Entity
@using MultiPurposeAuthSite.Resources
@using MultiPurposeAuthSite.ViewModels

@model OAuth2AuthorizationCodeGrantClientViewModel
@{
    ViewBag.Title = "OAuth2AuthorizationCodeGrantClient";
}

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title.</h2>
<hr />
@using (Html.BeginForm("OAuth2AuthorizationCodeGrantClient2", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form", onsubmit = "Fx_OnSubmit();" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ClientId)<br />
    
    <text>State:</text> @Html.TextBoxFor(model => model.State, new { @readonly = "readonly" })<br />
    <text>Code:</text> @Html.TextBoxFor(model => model.Code, new { @readonly = "readonly" })<br />

    <text>Access Token</text>
    <text>(JWT)</text>
    <text>:</text><br />

    @Html.TextBoxFor(model => model.AccessToken, new { style = "width:100%;", @readonly = "readonly" })<br />
    <text>Access Token (Json):<br /></text>
    @Html.TextArea("AccessTokenJwtToJson", Model.AccessTokenJwtToJson, new { style = "resize: both; width:100%; height:100px;", @readonly = "readonly" })<br />

    @Html.TextBoxFor(model => model.IdToken, new { style = "width:100%;", @readonly = "readonly" })<br />
    <text>Id Token (Json):<br /></text>
    @Html.TextArea("IdTokenJwtToJson", Model.IdTokenJwtToJson, new { style = "resize: both; width:100%; height:100px;", @readonly = "readonly" })<br />

    <text>Refresh Token:</text><br />
    @Html.TextBoxFor(model => model.RefreshToken, new { style = "width:100%;", @readonly = "readonly" })<br />
    <input class="btn btn-secondary btn-block" type="submit" name="submit.Refresh" value="Refresh" />
    <input class="btn btn-secondary btn-block" type="submit" name="submit.IntrospectRefresh" value="IntrospectRefresh" />
    <input class="btn btn-secondary btn-block" type="submit" name="submit.RevokeRefresh" value="RevokeRefresh" />
    <br />
    <input class="btn btn-secondary btn-block" type="submit" name="submit.GetUserClaims" value="Get user claims" />
    <input class="btn btn-secondary btn-block" type="submit" name="submit.IntrospectAccess" value="IntrospectAccess" />
    <input class="btn btn-secondary btn-block" type="submit" name="submit.RevokeAccess" value="RevokeAccess" />

    <text>Response:</text><br />
    @Html.TextArea("Response", Model.Response ?? "", new { style = "width:100%; height:200px;", @readonly = "readonly" })<br />
    <br />
    <a href="https://jwt.io/">JSON Web Tokens - jwt.io</a><br />
    <a href="https://syncer.jp/json-prettyprint">JSON Pretty Linter  - JSONの整形と構文チェック</a><br />
}


@*
    **RP からのログアウト**（RP-Initiated Logout 1.0。#232）。
    上のフォームとは別の form にする（入れ子にできないため）。
    /end_session は RP からの要求を受ける口なので、**AntiForgeryToken は付けない**
    （RP は持てない。確認画面からの応答だけが検証される）。
*@
<hr />
<form action="@(Config.OAuth2AuthorizationServerEndpointsRootURI + Config.OAuth2EndSessionEndpoint)" method="post">
    <input type="hidden" name="id_token_hint" value="@Model.IdToken" />
    @if (!string.IsNullOrEmpty(Model.IdToken))
    {
        @* **戻り先は、id_token_hint を送れるときだけ付ける。**
           id_token_hint が無いと、OP は戻り先の正当性を確かめられず、仕様上戻せない（§3）。 *@
        <input type="hidden" name="post_logout_redirect_uri" value="@(Config.OAuth2ClientEndpointsRootURI + "/Home/Index")" />
    }
    <input type="hidden" name="state" value="@Model.State" />
    <input class="btn btn-secondary btn-block" type="submit" value="Sign out (RP-Initiated Logout)" />
</form>
@if (!string.IsNullOrEmpty(Model.IdToken))
{
    <text>
        ※ id_token_hint を検証できるので、確認画面を挟まずにログアウトして post_logout_redirect_uri へ戻る。<br />
        ※ クライアントの登録に post_logout_redirect_uri（test_self_logout）が無い場合は、
        戻らずに確認画面へ進み、その理由が表示される（CONFIGURATION.md 4 節）。
    </text>
}
else
{
    <text>
        ※ scope に openid が無いフローでは id_token が発行されないため、id_token_hint を送れない。
        このため確認画面の経路になる（RP-Initiated Logout 1.0 §2）。<br />
        ※ 戻り先（post_logout_redirect_uri）も送らない。id_token_hint が無いと、
        OP は戻り先の正当性を確かめられないため、仕様上戻せない（§3）。
    </text>
}

@* スクリプト・セクション（RenderSection("FooterScriptsSection", required: true)に出力されます） *@
@section FooterScriptsSection{
    <!-- Footer 部の section -->
}
