    //**********************************************************************************
    //* クラス名        ：Account.Saml2Response
    //* クラス日本語名  ：Account.Saml2Response（SAML2 の応答とアサーション）
    //*
    //* 作成日時        ：－
    //* 作成者          ：－
    //* 更新履歴        ：－
    //*
    //*  日時        更新者            内容
    //*  ----------  ----------------  -------------------------------------------------
    //*  2026/09/28  玄人 幸道         新規（#246 の項目 3）
    //*  2026/10/07  玄人 幸道         Audience / Recipient / InResponseTo / 期限の照合を出した（#276）
    //**********************************************************************************

    **目視で確かめるための画面である。**
    以前は `?ret=認証完了（nameId=…）` / `?ret=認証失敗` という URL に移るだけで、
    **署名を検証できたのか、Issuer が違ったのかが分からず、
    読み取った属性も、アサーションの XML も捨てていた**（#246 の項目 3）。
*@

@using MultiPurposeAuthSite.Co
@using MultiPurposeAuthSite.Entity
@using MultiPurposeAuthSite.Resources

@using System.Web
@using System.Web.Mvc

@using Touryo.Infrastructure.Framework.Authentication

@{
    ViewBag.Title = "SAML2 Response (Assertion)";
}

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title</h2>
<hr />

<text>
    ※ SP（このサイトが兼ねているテスト用クライアント）が受け取った SAML2 の応答である。<br />
    ※ <b>判定には、署名・Issuer・Audience・Recipient・InResponseTo・RelayState のすべてが入る</b>（#276）。<br />
    ※ <b>StatusCode と NotOnOrAfter は、署名の検証（Open棟梁）が既に落とす</b>。<br />
    &nbsp;&nbsp;&nbsp;その場合は、<b>「署名の検証」が ✗ になる</b>ので、<b>上の理由を読むこと</b>。<br />
    ※ アサーションの XML は、下の欄にそのまま出している（<b>字下げのみ整形</b>）。
</text>
<br /><br />

@if ((string)ViewBag.Verdict == "NORMAL_END")
{
    <div class="alert alert-success">
        <b>NORMAL_END</b> : @ViewBag.Reason
    </div>
}
else
{
    <div class="alert alert-warning">
        <b>ABNORMAL_END</b> : @ViewBag.Reason
    </div>
}

<table class="table table-bordered">
    <tr>
        <th style="width:25%;">バインディング</th>
        <td>@ViewBag.Binding</td>
    </tr>
    <tr>
        <th>SigAlg</th>
        <td>@(string.IsNullOrEmpty((string)ViewBag.SigAlg) ? "（無し。POST は XML の中の署名）" : ViewBag.SigAlg)</td>
    </tr>
    <tr>
        <th>署名の検証</th>
        <td><b>@((bool)ViewBag.SignatureVerified ? "✓ 検証できた" : "✗ 検証できなかった")</b></td>
    </tr>
    <tr>
        <th>Issuer の一致</th>
        <td><b>@((bool)ViewBag.IssuerMatched ? "✓ 一致" : "✗ 不一致")</b></td>
    </tr>
    @*  **照合ごとに出す**（#276）。**期待値を渡していない経路は null** になる。 *@
    @{
        bool? audMatched = (bool?)ViewBag.AudienceMatched;
        bool? rcpMatched = (bool?)ViewBag.RecipientMatched;
        bool? irtMatched = (bool?)ViewBag.InResponseToMatched;
        bool? notExpired = (bool?)ViewBag.NotExpired;
    }
    <tr>
        <th>Audience の照合</th>
        <td><b>@(audMatched == true ? "✓ 自分の ACS URL" : (audMatched == false ? "✗ 別の相手あて" : "（照合していない）"))</b></td>
    </tr>
    <tr>
        <th>Recipient の照合</th>
        <td><b>@(rcpMatched == true ? "✓ 自分の ACS URL" : (rcpMatched == false ? "✗ 別の宛先" : "（照合していない）"))</b></td>
    </tr>
    <tr>
        <th>InResponseTo の照合</th>
        <td><b>@(irtMatched == true ? "✓ 送った要求の ID と一致" : (irtMatched == false ? "✗ 送った要求と対応しない" : "（照合していない）"))</b></td>
    </tr>
    <tr>
        <th>有効期限</th>
        <td><b>@(notExpired == true ? "✓ 期限内" : (notExpired == false ? "✗ 期限切れ" : "（読めなかった）"))</b></td>
    </tr>
    <tr>
        <th>NameID / NameIDFormat</th>
        <td>
            <b>@(string.IsNullOrEmpty((string)ViewBag.NameId) ? "（無し）" : ViewBag.NameId)</b>
            / @(string.IsNullOrEmpty((string)ViewBag.NameIdFormat) ? "（無し）" : ViewBag.NameIdFormat)
        </td>
    </tr>
    <tr>
        <th>Issuer</th>
        <td>@(string.IsNullOrEmpty((string)ViewBag.Issuer) ? "（無し）" : ViewBag.Issuer)</td>
    </tr>
    <tr>
        <th>Audience</th>
        <td>@(string.IsNullOrEmpty((string)ViewBag.Audience) ? "（無し）" : ViewBag.Audience)</td>
    </tr>
    <tr>
        <th>StatusCode</th>
        <td>@(string.IsNullOrEmpty((string)ViewBag.StatusCode) ? "（無し）" : ViewBag.StatusCode)</td>
    </tr>
    <tr>
        <th>AuthnContextClassRef</th>
        <td>@(string.IsNullOrEmpty((string)ViewBag.AuthnContextClassRef) ? "（無し）" : ViewBag.AuthnContextClassRef)</td>
    </tr>
    <tr>
        <th>InResponseTo / Recipient</th>
        <td>
            @(string.IsNullOrEmpty((string)ViewBag.InResponseTo) ? "（無し）" : ViewBag.InResponseTo)
            / @(string.IsNullOrEmpty((string)ViewBag.Recipient) ? "（無し）" : ViewBag.Recipient)
        </td>
    </tr>
    <tr>
        <th>NotOnOrAfter</th>
        <td>@(string.IsNullOrEmpty((string)ViewBag.NotOnOrAfter) ? "（無し）" : ViewBag.NotOnOrAfter)</td>
    </tr>
    <tr>
        <th>RelayState</th>
        <td>
            @(string.IsNullOrEmpty((string)ViewBag.RelayState) ? "（無し）" : ViewBag.RelayState)
            @{ bool? matched = (bool?)ViewBag.RelayStateMatched; }
            @if (matched == true)
            {
                <b>（✓ 送った state と一致）</b>
            }
            else if (matched == false)
            {
                <b>（✗ 送った state と不一致）</b>
            }
            else
            {
                <text>（照合していない。state を保存していない経路）</text>
            }
        </td>
    </tr>
</table>

<text>応答の XML（アサーションを含む。署名の要素もそのまま）:</text><br />
@Html.TextArea("ResponseXml", (string)ViewBag.ResponseXml ?? "",
    new { style = "resize: both; width:100%; height:400px; font-family: monospace;", @readonly = "readonly" })<br />

@if (string.IsNullOrEmpty((string)ViewBag.ResponseXml))
{
    <div class="alert alert-warning">
        XML を読めなかった（応答が無い、または XML として解釈できなかった）。上の理由を確認すること。
    </div>
}

<a class="btn btn-default" href="@Url.Action("Saml2OAuth2Starters", "Home")">自己テストの一覧に戻る</a>

@section FooterScriptsSection{
    <!-- Footer 部の section -->
}
