@using System.Collections.Generic

@using MultiPurposeAuthSite.Co
@using MultiPurposeAuthSite.Entity
@using MultiPurposeAuthSite.Resources
@using MultiPurposeAuthSite.ViewModels

@model AccountLoginViewModel

@{
    ViewBag.Title = AccountViews.LoginTitle;
}

@Scripts.Render("~/bundles/multiauthsite")

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
    <!-- Head 部の section -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/6.10.1/sweetalert2.min.css" />
}

<h2>@ViewBag.Title</h2>
<div class="row">
    <div class="col-md-8">
        <h4>@AccountViews.LoginH4</h4>
        <hr />
        <section id="loginForm">
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "LoginForm", @class = "form-horizontal", role = "form", onsubmit = "Fx_OnSubmit();" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.ReturnUrl)

                @* **「利用者名またはメアド」の入力**（#151 の段階 3）。
                   **欄の名前（Email）は変えていない。** ビュー・リソース・E2E・ID 連携の
                   login_hint に波及するため、名前の整理は後の段階に回す。 *@
                <div class="form-group">
                    @Html.LabelFor(m => m.Email, new { @class = "col-md-2 control-label" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Password, new { @class = "col-md-2 control-label" })
                    <div class="col-md-10">
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <div class="checkbox">
                            @Html.CheckBoxFor(m => m.RememberMe)
                            @Html.LabelFor(m => m.RememberMe)
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <button id="normal_signin" name="submitButton" value="normal_signin" type="button" class="btn btn-primary">@AccountViews.LoginSubmit</button>
                    </div>
                </div>
                <p>@Html.ActionLink(AccountViews.LoginRegisterActionLink, "Register")</p>
                <p>
                    @*Enable this once you have account confirmation enabled for password reset functionality*@
                    @*これを有効にする前に、パスワード リセット機能に対するアカウント確認を有効にしてください。*@
                    @Html.ActionLink(AccountViews.LoginForgotPasswordActionLink, "ForgotPassword")
                </p>

                // **net48 版では使わない欄**（#137）。
                //   ViewModel を両系統で共有しているので、欄だけ残す。
                @Html.HiddenFor(m => m.SequenceNo)
                @Html.HiddenFor(m => m.Fido2Data)

                <input type="hidden" id="submitButtonName" name="submitButtonName" value="">
                @*  **どの上流 IdP へ委譲するか**（#292 の段階 1）。
                    **空なら既定**（先頭の 1 件）なので、**送ってこない要求も従来どおり通る。** *@
                @Html.HiddenFor(m => m.IdpKey)
            }
        </section>
    </div>
    <div class="col-md-4">

@if (Config.CanEditExtLogin)
{
        <div class="sample-box-1">
            @*ここに外部ログインを実装*@
            @AccountViews.ExternalLogins
            <section id="socialLoginForm">
                @Html.Partial("_ExternalLoginsListPartial", new AccountExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl })
            </section>
        </div>
}

        @*  **ID フェデレーションの導線は、設定が揃っているときだけ出す**（#286 の段階 2）。
            **押しても成立しないボタンを出さない**ため。
            **以前は無条件に出ていた**ので、口を設定していない配備でも押せた。

            **上流は n 件**（#292 の段階 1）。**登録 1 件につきボタン 1 つ**を出す。
            **登録が無ければ、従来の単数キーから 1 件が組み立てられる**ので、
            **1 件の配備の見た目は変わらない**（id もラベルも従来どおり）。 *@
        @{
            List<IdFederationUpstream> oidcUpstreams =
                IdFederationUpstreams.List(IdFederationUpstream.Oidc);
            List<IdFederationUpstream> saml2Upstreams =
                IdFederationUpstreams.List(IdFederationUpstream.Saml2);
        }
        @if (0 < oidcUpstreams.Count)
        {
            <div class="sample-box-1">
                @*ここにIDフェデレーションを実装*@
                @AccountViews.IdFederationLogin
                <section>
                    @for (int i = 0; i < oidcUpstreams.Count; i++)
                    {
                        @*  **1 件目の id は従来どおり**（既存の導線・E2E・UI テストが引いている）。
                            **2 件目からは鍵を付ける。** **相手は data 属性で送る**ので、
                            **`submitButtonName` の値は 1 件でも n 件でも同じ**である。 *@
                        <button id="@(i == 0 ? "id_federation_signin" : "id_federation_signin_" + oidcUpstreams[i].Key)"
                                name="submitButton" value="id_federation_signin"
                                data-idp-key="@oidcUpstreams[i].Key"
                                type="button" class="btn btn-primary id_federation_button">
                            @(oidcUpstreams.Count == 1
                                ? AccountViews.IdFederationLoginSubmit : oidcUpstreams[i].Label)
                        </button>
                    }
                </section>
            </div>
        }
        @if (0 < saml2Upstreams.Count)
        {
            <div class="sample-box-1">
                @AccountViews.IdFederationSaml2Login
                <section>
                    @for (int i = 0; i < saml2Upstreams.Count; i++)
                    {
                        <button id="@(i == 0 ? "id_federation_saml2_signin" : "id_federation_saml2_signin_" + saml2Upstreams[i].Key)"
                                name="submitButton" value="id_federation_saml2_signin"
                                data-idp-key="@saml2Upstreams[i].Key"
                                type="button" class="btn btn-primary id_federation_button">
                            @(saml2Upstreams.Count == 1
                                ? AccountViews.IdFederationSaml2LoginSubmit : saml2Upstreams[i].Label)
                        </button>
                    }
                </section>
            </div>
        }
    </div>
</div>

@* スクリプト・セクション（RenderSection("FooterScriptsSection", required: true)に出力されます） *@
@section FooterScriptsSection{
    <!-- Footer 部の section -->
    <script>
        $(function () {
            $("#normal_signin").on("click", function () {
                // button name
                $("#submitButtonName").val(this.value);
                // submit
                $("#LoginForm").submit();
            });
        });
    </script>

    <script>
        // Id federationLogin
        $(function () {
            //  **ID 連携のボタンは、OIDC も SAML2 も、1 件でも n 件でも同じ扱い**（#292 の段階 1）。
            //    **class で束ねる。** **id で束ねていた頃は、SAML2 のボタンに
            //    ハンドラが付いておらず、ブラウザでは押しても何も起きなかった**
            //    （E2E はフォームを直接 POST するので、気付けなかった）。
            $(".id_federation_button").on("click", function () {
                // button name
                $("#submitButtonName").val(this.value);
                // **どの上流か**（空なら既定）
                $("#IdpKey").val($(this).data("idp-key"));
                // submit
                $("#LoginForm").submit();
            });
        });
    </script>
}