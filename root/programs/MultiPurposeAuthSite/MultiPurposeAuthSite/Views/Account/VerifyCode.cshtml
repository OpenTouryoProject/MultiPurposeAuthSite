@using MultiPurposeAuthSite.Co
@using MultiPurposeAuthSite.Entity
@using MultiPurposeAuthSite.Resources
@using MultiPurposeAuthSite.ViewModels

@model AccountVerifyCodeViewModel
@{
    ViewBag.Title = AccountViews.VerifyCodeTitle;
}

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("VerifyCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", onsubmit = "Fx_OnSubmit();" })) {
    @Html.AntiForgeryToken()
    @Html.Hidden("provider", @Model.Provider)
    @Html.Hidden("rememberMe", @Model.RememberMe)
    <h4>@AccountViews.VerifyCodeH4</h4>
    <hr />
    @Html.ValidationSummary("", new { @class = "text-danger" })
    <div class="form-group">
        @Html.LabelFor(m => m.Code, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Code, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <div class="checkbox">
                @Html.CheckBoxFor(m => m.RememberBrowser)
                @Html.LabelFor(m => m.RememberBrowser)
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" class="btn btn-primary" value="@AccountViews.VerifyCodeSubmit" />
        </div>
    </div>
}

@* スクリプト・セクション（RenderSection("FooterScriptsSection", required: true)に出力されます） *@
@section FooterScriptsSection{
    <!-- Footer 部の section -->

    @* プッシュ承認の待ち受け（#216）。MobileApp のときだけ動かす。 *@
    @if (Model.Provider == MultiPurposeAuthSite.Manager.MobileAppTokenProvider.ProviderName)
    {
        <p id="pushWaiting" class="text-muted">
            認証デバイスで承認すると、自動でサインインします（コードの入力でも完了できます）。
        </p>

        <script>
            (function () {
                // 承認されたか、認証サイトに定期的に尋ねる。
                // **待っているのはブラウザ**で、認証デバイスは /2fa_result に承認を送るだけ。
                var url = '@Url.Action("TwoFactorPushStatus", "Account")'
                    + '?returnUrl=' + encodeURIComponent('@Html.Raw(Model.ReturnUrl)')
                    + '&rememberBrowser=' + (document.getElementById('RememberBrowser') || {}).checked;

                var timer = setInterval(function () {
                    fetch(url, { credentials: 'same-origin' })
                        .then(function (res) { return res.ok ? res.json() : null; })
                        .then(function (data) {
                            if (data && data.approved && data.redirectUrl) {
                                clearInterval(timer);
                                window.location.href = data.redirectUrl;
                            }
                        })
                        .catch(function () { /* 一時的な失敗は無視して、次回に試す */ });
                }, 2000);

                // 放置されたままにしない（2FA のコードの有効期間に合わせる）。
                setTimeout(function () {
                    clearInterval(timer);
                    var p = document.getElementById('pushWaiting');
                    if (p) { p.textContent = '自動での承認の待ち受けを終了しました。コードを入力してください。'; }
                }, 3 * 60 * 1000);
            })();
        </script>
    }
}
