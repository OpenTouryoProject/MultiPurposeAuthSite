@using MultiPurposeAuthSite.Co
@using MultiPurposeAuthSite.Entity
@using MultiPurposeAuthSite.Resources
@using MultiPurposeAuthSite.ViewModels

@using Touryo.Infrastructure.Framework.Authentication;

@{
    ViewBag.Title = AccountViews.OAuth2AuthorizeTitle;
}

@* スクリプト・セクション（RenderSection("HeaderScriptsSection", required: true)に出力されます） *@
@section HeaderScriptsSection{
    <!-- Head 部の section -->
}

<h2>@ViewBag.Title</h2>
<div class="row">
    <div class="col-md-8">
        <h4>@ViewBag.Message</h4>
        <hr />
        <form method="POST">
            @Html.AntiForgeryToken() @*追加*@

            <p>@AccountViews.OAuth2AuthorizeP1 @Html.Label("name", (string)ViewBag.Name)</p>
            <p>@AccountViews.OAuth2AuthorizeP2</p>
            <ul>
                @foreach (string scope in ViewBag.Scopes)
                {
                    <li>@Html.Label(OAuth2AndOIDCConst.scope, scope)</li>
                }
            </ul>
            <p>
                <input class="btn btn-primary" type="submit" name="submit.Grant" value="@AccountViews.OAuth2AuthorizeGrantButton" />
                <input class="btn btn-primary" type="submit" name="submit.Deny" value="@AccountViews.OAuth2AuthorizeDenyButton" />
                <input class="btn btn-primary" type="submit" name="submit.Login" value="@AccountViews.OAuth2AuthorizeSIDUButton" />
            </p>
        </form>
        @*
            **ここから下は、自己テストのための表示である**（#246 の項目 3）。
            **`IsLockedDownTestEndpoints`（自己テストを閉じる設定）が true の配置では出さない**
            （項目 4 の線引き。利用者に見せるものではない）。
        *@
        @if (!Config.IsLockedDownTestEndpoints)
        {
            <hr />
            <h4>この画面で確かめること（自己テスト）</h4>
            <table class="table table-bordered">
                <tr>
                    <th style="width:30%;">なぜこの画面が出たか</th>
                    <td>
                        <b>このクライアントに対する同意の記録が無い（または要求された scope に
                        記録に無いものが在る）ため</b>、同意を求めている。<br />
                        <b>許可すれば記録する</b>ので、<b>次回以降はこの画面は出ない</b>
                        （#272 の段階 2。<code>ANALYSIS-IdP.md</code> の D-6）。<br />
                        <b><code>prompt=consent</code> を指定すれば、記録が在っても出す。</b>
                        記録を消すには <code>/Manage/ConsentGrants</code> から取り消す。<br />
                        <b>認証用の scope（<code>auth</code>）のときは、従来どおりこの画面を出さない。</b>
                    </td>
                </tr>
                <tr>
                    <th>client_id / response_type</th>
                    <td>@ViewBag.ClientId / @ViewBag.ResponseType</td>
                </tr>
                <tr>
                    <th>redirect_uri（照合済み）</th>
                    <td>@ViewBag.ValidRedirectUri</td>
                </tr>
                <tr>
                    <th>response_mode</th>
                    <td>@(string.IsNullOrEmpty((string)ViewBag.ResponseMode) ? "（既定）" : ViewBag.ResponseMode)</td>
                </tr>
                <tr>
                    <th>prompt</th>
                    <td>
                        @(string.IsNullOrEmpty((string)ViewBag.Prompt) ? "（指定なし）" : ViewBag.Prompt)<br />
                        <b>none を指定すると、UI を出さずに済ませるかを試せる。</b><br />
                        <b>同意が記録されていれば code が返る</b>が、
                        <b>記録が無ければ <code>consent_required</code></b> が <code>redirect_uri</code> へ返る
                        （#272 の段階 2。以前は記録を持たず、<b>無音で通していた</b>。C-3）。<br />
                        <b><code>none</code> を他の値と併記すると <code>invalid_request</code></b>（#272 の段階 1）。<br />
                        <b>consent</b> … 記録が在ってもこの画面を出す。
                        <b>login</b> … 再認証を求める。
                        <b>select_account</b> … この画面を出す
                        （<b>アカウントの一覧から選ぶ仕組みは持っていない</b>）。
                    </td>
                </tr>
                <tr>
                    <th>max_age</th>
                    <td>
                        @(string.IsNullOrEmpty((string)ViewBag.MaxAge) ? "（指定なし）" : ViewBag.MaxAge)<br />
                        <b>前回の認証からの経過時間の上限。</b>超えていれば、OP は再認証を求めるべきもの。
                    </td>
                </tr>
                <tr>
                    <th>request_uri（PAR / ros 経由か）</th>
                    <td>@(string.IsNullOrEmpty((string)ViewBag.RequestUri) ? "（クエリ文字列の要求）" : ViewBag.RequestUri)</td>
                </tr>
                <tr>
                    <th>state / nonce / claims</th>
                    <td>
                        state=@((bool)ViewBag.HasState ? "あり" : "なし")
                        / nonce=@((bool)ViewBag.HasNonce ? "あり" : "なし")
                        / claims=@((bool)ViewBag.HasClaims ? "あり" : "なし")
                        <br />（<b>値は出さない</b>。有無だけで足りるため）
                    </td>
                </tr>
                <tr>
                    <th>次に見るところ</th>
                    <td>
                        [Grant] を押すと、要求した <code>response_mode</code> で戻る。<br />
                        戻り先の画面に <b>code / id_token / access_token の実値と、
                        トークン要求に使ったクライアント認証の方式</b>が出る（#246）。
                    </td>
                </tr>
            </table>
        }
    </div>
</div>

@* スクリプト・セクション（RenderSection("FooterScriptsSection", required: true)に出力されます） *@
@section FooterScriptsSection{
    <!-- Footer 部の section -->
}