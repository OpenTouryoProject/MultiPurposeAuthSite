    //**********************************************************************************
    //* クラス名        ：_ClientDisplayPartial
    //* クラス日本語名  ：承認の画面（同意・サインイン）に出す、クライアントの情報
    //*
    //* 作成日時        ：－
    //* 作成者          ：－
    //* 更新履歴        ：－
    //*
    //*  日時        更新者            内容
    //*  ----------  ----------------  -------------------------------------------------
    //*  2026/11/24  玄人 幸道         新規（logo_uri・policy_uri・tos_uri。OIDC Registration 1.0 §2。#427）
    //**********************************************************************************
*@

@using MultiPurposeAuthSite.Resources
@model MultiPurposeAuthSite.Util.Sts.ClientDisplay

@*
    **URL は `ClientDisplay` が https の絶対 URI だけに絞ってある**（それ以外は null。登録では絶対 URI であることしか見ていない）。
    **値は Razor がエスケープする。** 外へのリンクは、開いた先から元の画面を触らせない（`noopener`）・参照元を渡さない（`noreferrer`）。
    **ロゴの画像も、参照元を渡さない**（`referrerpolicy="no-referrer"`。サインインの画面の URL は、認可の要求の `state` などを含む `ReturnUrl` を持つ）。
    **呼ぶ側は、Model が null のときは呼ばない**（null を渡すと、親のモデルが渡る）。
    **`client_name` は出さない**（画面・動的登録の登録の名前は、登録した利用者の利用者名のため。`ClientDisplay` の remarks。#427）。
*@
<div id="client-display" class="client-display">
    @if (!string.IsNullOrEmpty(Model.LogoUri))
    {
        <img id="client-logo" src="@Model.LogoUri" alt="@AccountViews.ClientDisplayLogo" referrerpolicy="no-referrer" style="max-height: 64px; max-width: 256px;" />
    }
    @if (!string.IsNullOrEmpty(Model.PolicyUri) || !string.IsNullOrEmpty(Model.TosUri))
    {
        <p>
            @if (!string.IsNullOrEmpty(Model.PolicyUri))
            {
                <a id="client-policy" href="@Model.PolicyUri" target="_blank" rel="noopener noreferrer">@AccountViews.ClientDisplayPolicy</a>
            }
            @if (!string.IsNullOrEmpty(Model.TosUri))
            {
                <a id="client-tos" href="@Model.TosUri" target="_blank" rel="noopener noreferrer">@AccountViews.ClientDisplayTos</a>
            }
        </p>
    }
</div>
