{
  // MPAS スタブに渡すアプリの設定（サンプル）。README.md の 3 節。
  //   **appsettings.json と同じ書き方。** 雛形（_appsettings.json）の値に重ねて効く。
  //   **書いたキーだけが変わる。** 入れ子（OAuth2ClientsInformation）は、キーごとに足される。
  //   **docker-compose.yml の environment に在るキー（公開 URL・iss・管理者など）は、ここでは変えられない**（.env で変える）。
  "appSettings": {

    // ---- テストする RP / SP のクライアントを登録する（client_id は 32 桁の 16 進）
    //   redirect_uri_code  : 認可コード フローの戻り先（**1 文字も違ってはならない**）
    //   redirect_uri_token : Implicit の戻り先（使わなければ "-"）
    //   redirect_uri_saml  : SAML2 の ACS（使わなければ省く）
    //   **値はテスト専用にすること。**
    "OAuth2ClientsInformation": {
      "57ab0000000000000000000000000001": {
        "client_secret": "Stub_Sample_Secret_ChangeMe",
        "redirect_uri_code": "https://localhost:5001/signin-oidc",
        "redirect_uri_token": "-",
        "client_name": "StubSampleRP"
      }
    },

    // ---- 機能の切り替え（例。要るものだけ書く）
    //   動的クライアント登録（RFC 7591）を開けるなら "true"（RP が自分で登録できる）
    "EnableDynamicClientRegistration": "false"
  }
}
