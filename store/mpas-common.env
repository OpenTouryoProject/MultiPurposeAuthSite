# ##################################################################################################
# どのコンテナにも要る設定（#281）
#
#   **上流・下流のどちらのサービスも、これを env_file で読む。**
#   役に依らない「コンテナ化の都合」だけを置く。役ごとの設定は docker-compose.yml に書く。
#
#   **ここに置く理由。** 雛形の設定は 19 箇所が C:/root/files/resource/... であり（Windows 前提）、
#   Linux ではドライブ文字が効かないため、マウント先（/resource）へ振り替える必要がある。
#   **1 つでも漏らすと、その設定を使った瞬間に落ちる。**
#   サービスごとに書くと 2 回書くことになり、片方だけ直す事故が起きる。
#
#   **件数の突き合わせ方**（増減したらここも直す）。
#     appsettings.json を "C:/root/files で grep した数 ＝ ここの行数（19。実測 2026/10/08）
#
#   **ここに秘密を書かない。** 置いてよいのはパスだけである。
#   証明書のパスワード（CERT_PASSWORD）は store\.env に在り、compose が環境変数で渡す。
#
#   **env_file の値はそのまま渡る**（${...} の展開はされない）。
# ##################################################################################################

# log4net だけは中身（出力先）も Windows のパスなので、イメージに入れた差し替え版を指す
appSettings__FxLog4NetConfFile=/app/LogConf.xml

# Open棟梁 のフレームワーク定義
appSettings__FxXMLSPDefinition=/resource/XML/SPDefinition.xml
appSettings__FxXMLMSGDefinition=/resource/XML/MSGDefinition.xml
appSettings__FxXMLTCDefinition=/resource/XML/TCDefinition.xml
appSettings__FxXMLTMInProcessDefinition=/resource/XML/TMInProcessDefinition.xml

# プッシュ通知とメールの雛形
appSettings__FirebaseServiceAccountKey=/resource/MultiPurposeAuthSite/FirebaseServiceAccountKey.json
appSettings__ContentOfLetterFilePath=/resource/MultiPurposeAuthSite/Txt

# IdP 側の署名鍵（ES384 / ES512 は曲線が alg に紐づくので鍵が分かれる。#129 の段階 3）
appSettings__JwkSetFilePath=/resource/MultiPurposeAuthSite/JwkSet.json
appSettings__RsaPfxFilePath=/resource/X509/SHA256RSA_Server.pfx
appSettings__EcdsaPfxFilePath=/resource/X509/SHA256ECDSA_Server.pfx
appSettings__Ecdsa384PfxFilePath=/resource/X509/SHA384ECDSA.pfx
appSettings__Ecdsa512PfxFilePath=/resource/X509/SHA521ECDSA.pfx

# SP / RP 側（自己テストが検証に使う証明書と鍵）
appSettings__SpRp_RsaCerFilePath=/resource/X509/SHA256RSA_Server.cer
appSettings__SpRp_EcdsaCerFilePath=/resource/X509/SHA256ECDSA_Server.cer
appSettings__SpRp_Ecdsa384CerFilePath=/resource/X509/SHA384ECDSA.cer
appSettings__SpRp_Ecdsa512CerFilePath=/resource/X509/SHA521ECDSA.cer
appSettings__SpRp_RsaPfxFilePath=/resource/X509/SHA256RSA_Client.pfx
appSettings__SpRp_EcdsaPfxFilePath=/resource/X509/SHA256ECDSA_Client.pfx
appSettings__SpRp_ClientCertPfxFilePath=/resource/X509/SHA256RSAClientCert.pfx
